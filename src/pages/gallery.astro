---
import Base from '../layouts/Base.astro';
import Sc from '../components/Sc.astro';
import { albums } from '../data/temple';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const m = (p: string) => `${base}media/${p}`;
// the temple's own naming: "Padi Pooja at Temple | 12-11-2026"
const dmy = (s: string) => s.split('-').reverse().join('-');
const longDate = (s: string) => new Intl.DateTimeFormat('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }).format(new Date(s + 'T00:00:00+05:30'));
const sorted = [...albums].sort((a, b) => b.date.localeCompare(a.date));
const KINDS = [
  { id: 'padi', label: 'Padi pooja' },
  { id: 'kanne', label: 'Kanne pooja' },
  { id: 'festival', label: 'Festivals' },
] as const;
const kinds = KINDS.filter((k) => sorted.some((a) => a.kind === k.id));
const count = (type: 'photo' | 'video', list = sorted) => list.reduce((n, a) => n + a.items.filter((i) => i.type === type).length, 0);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
const counts = (list: typeof sorted) => [plural(count('photo', list), 'photo'), count('video', list) ? plural(count('video', list), 'video') : ''].filter(Boolean).join(' · ');
// every item in page order, for the viewer
const items = sorted.flatMap((a) => a.items.map((it, n) => ({
  album: a.id, kind: a.kind, n: n + 1, of: a.items.length, type: it.type, src: m(it.src), poster: m(it.thumb), w: it.w, h: it.h, alt: it.alt,
  caption: `${a.title} | ${dmy(a.date)}`,
})));
const hero = sorted.flatMap((a) => a.items).find((i) => i.type === 'photo');
let gi = 0;
---
<Base page="gallery" title="Gallery" description="Photos and videos of padi poojas, kanne poojas and festivals at the Ayyappa Swamy Temple, Kodathi, and at swamys’ homes." image={hero ? `media/${hero.src}` : undefined}>
  <section class="page-hero gh">
    {hero && <div class="page-hero__media"><img src={m(hero.src)} alt="" /></div>}
    <div class="wrap">
      <h1 class="t-1">Gallery</h1>
      <p class="lede" style="margin-top:20px">Padi poojas, kanne poojas and festivals, at the temple and at swamys’ homes. A new album after every pooja.</p>
      <p class="small gh__count" data-gal-total>{plural(sorted.length, 'album')} · {counts(sorted)}</p>
    </div>
  </section>

  <section class="section gp">
    <div class="wrap">
      {kinds.length > 1 && (
        <div class="gp__filters" role="group" aria-label="Show albums">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="num">{sorted.length}</span></button>
          {kinds.map((k) => (
            <button class="chip" type="button" data-filter={k.id} aria-pressed="false">{k.label} <span class="num">{sorted.filter((a) => a.kind === k.id).length}</span></button>
          ))}
        </div>
      )}

      <div class="gp__albums">
        {sorted.map((a) => (
          <article class="alb" data-album={a.id} data-kind={a.kind} aria-labelledby={`t-${a.id}`} data-rise>
            <header class="alb__head">
              <p class="alb__date num"><time datetime={a.date}>{dmy(a.date)}</time></p>
              <h2 class="t-3" id={`t-${a.id}`}>{a.title}</h2>
              <Sc tag="p" kn={a.kn} te={a.te} class="alb__sc" />
              <p class="small">{longDate(a.date)}<br />{counts([a])}</p>
            </header>
            <ul class="alb__grid">
              {a.items.map((it) => {
                const i = gi++;
                return (
                  <li class={`tile tile--${it.type}`}>
                    <button type="button" class="tile__btn" data-open={i} aria-label={`Open ${it.type} ${items[i].n} of ${a.items.length}, ${a.title}: ${it.alt}`}>
                      <img src={m(it.thumb)} alt="" loading="lazy" width="480" height="640" />
                      {it.type === 'video' && <span class="tile__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>Video</span>}
                    </button>
                  </li>
                );
              })}
            </ul>
          </article>
        ))}
      </div>
      <p class="small gp__more">Have photos from a pooja? Send them to the temple on WhatsApp with the pooja’s name and date, and we’ll add an album.</p>
    </div>
  </section>

  <!-- Full-screen viewer -->
  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-labelledby="lb-cap">
    <div class="lb__bar">
      <p class="lb__cap" id="lb-cap" data-lb-cap></p>
      <p class="lb__n num" data-lb-n aria-live="polite"></p>
      <div class="lb__ctl">
        <button class="pill" type="button" data-lb-share>Share</button>
        <button class="pill" type="button" data-lb-close>Close</button>
      </div>
    </div>
    <div class="lb__stage" data-lb-stage></div>
    <p class="lb__alt small" data-lb-alt></p>
    <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
    <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
  </div>
  <script type="application/json" id="gal-items" set:html={JSON.stringify(items)} />
</Base>

<script>
  import { getLenis, sound, reduced } from '../scripts/core';

  type Item = { album: string; kind: string; n: number; of: number; type: 'photo' | 'video'; src: string; poster: string; w: number; h: number; alt: string; caption: string };
  const items: Item[] = JSON.parse(document.getElementById('gal-items')!.textContent || '[]');
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

  /* ---------- filters ---------- */
  let filter = 'all';
  const visible = () => items.map((_, i) => i).filter((i) => filter === 'all' || items[i].kind === filter);
  $$<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.filter!;
    $$('[data-filter]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    $$('[data-album]').forEach((a) => { a.hidden = filter !== 'all' && a.dataset.kind !== filter; });
  }));

  /* ---------- viewer ---------- */
  const lb = $('[data-lb]'), stage = $('[data-lb-stage]');
  let list: number[] = [], at = 0, opener: HTMLElement | null = null;

  function render() {
    const it = items[list[at]];
    stage.querySelector('video')?.pause();
    stage.replaceChildren();
    if (it.type === 'photo') {
      const img = new Image();
      img.src = it.src; img.alt = it.alt; img.width = it.w; img.height = it.h; img.decoding = 'async';
      img.className = 'lb__media';
      stage.append(img);
    } else {
      const v = document.createElement('video');
      v.src = it.src; v.poster = it.poster; v.controls = true; v.playsInline = true; v.autoplay = true; v.className = 'lb__media';
      v.setAttribute('aria-label', it.alt); v.width = it.w; v.height = it.h;
      // the chant steps back while a video plays with its own sound
      v.addEventListener('play', () => sound.duck(0.06));
      v.addEventListener('pause', () => sound.duck(0.55));
      stage.append(v);
    }
    $('[data-lb-cap]').textContent = it.caption;
    $('[data-lb-n]').textContent = `${at + 1} of ${list.length}`;
    $('[data-lb-alt]').textContent = it.alt;
    const one = list.length < 2;
    ($('[data-lb-prev]') as HTMLButtonElement).hidden = one;
    ($('[data-lb-next]') as HTMLButtonElement).hidden = one;
    history.replaceState(null, '', `#${it.album}/${it.n}`);
    // warm the neighbours so swiping feels instant
    [list[(at + 1) % list.length], list[(at - 1 + list.length) % list.length]].forEach((j) => { if (items[j].type === 'photo') new Image().src = items[j].src; });
    if (!reduced) stage.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' });
  }
  function open(i: number, from?: HTMLElement) {
    list = visible().includes(i) ? visible() : items.map((_, j) => j);
    at = list.indexOf(i);
    opener = from ?? null;
    lb.hidden = false;
    document.documentElement.classList.add('lb-open');
    getLenis()?.stop();
    render();
    $<HTMLButtonElement>('[data-lb-close]').focus();
  }
  function close() {
    stage.querySelector('video')?.pause();
    stage.replaceChildren();
    sound.duck(0.55);
    lb.hidden = true;
    document.documentElement.classList.remove('lb-open');
    getLenis()?.start();
    history.replaceState(null, '', location.pathname + location.search);
    opener?.focus();
  }
  const go = (d: number) => { at = (at + d + list.length) % list.length; render(); };

  $$<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.open), b)));
  $('[data-lb-close]').addEventListener('click', close);
  $('[data-lb-prev]').addEventListener('click', () => go(-1));
  $('[data-lb-next]').addEventListener('click', () => go(1));
  // a click on the dark around the photo closes, as people expect
  stage.addEventListener('click', (e) => { if (e.target === stage) close(); });

  $('[data-lb-share]').addEventListener('click', async () => {
    const it = items[list[at]];
    const url = location.href;
    if (navigator.share) { try { await navigator.share({ title: it.caption, url }); } catch (e) {} return; }
    window.open(`https://wa.me/?text=${encodeURIComponent(`${it.caption} ${url}`)}`, '_blank', 'noopener');
  });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowRight') go(1);
    else if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === 'Tab') {
      // keep focus inside the viewer
      const f = $$<HTMLElement>('button:not([hidden]), video', lb);
      const i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  });

  // swipe left and right on phones; a drag that starts on a video's controls is left alone
  let sx = 0, sy = 0, track = false;
  stage.addEventListener('pointerdown', (e) => {
    const v = (e.target as HTMLElement).closest('video');
    track = e.pointerType !== 'mouse' && !(v && e.clientY > v.getBoundingClientRect().bottom - 64);
    sx = e.clientX; sy = e.clientY;
  });
  stage.addEventListener('pointerup', (e) => {
    if (!track) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) go(dx < 0 ? 1 : -1);
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.4) close();
    track = false;
  });

  // a shared link opens straight on its photo: /gallery/#<album>/<n>
  const m = location.hash.match(/^#(.+)\/(\d+)$/);
  if (m) {
    const i = items.findIndex((it) => it.album === decodeURIComponent(m[1]) && it.n === Number(m[2]));
    if (i >= 0) open(i, $(`[data-open="${i}"]`));
  }
</script>

<style>
  .gh { min-height: 64svh; }
  .gh :global(.page-hero__media img) { object-position: center 30%; }
  .gh__count { margin-top: 18px; color: #e9dcc6; }
  .gp__filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: clamp(36px, 5vw, 64px); }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--rule); background: transparent; color: var(--fg); font: 500 15px/1 var(--body); cursor: pointer; transition: background .2s, border-color .2s, color .2s; }
  .chip .num { color: var(--sub); font-size: 13px; }
  .chip:hover { border-color: var(--acc); }
  .chip[aria-pressed='true'] { background: var(--acc); border-color: var(--acc); color: #1a120a; }
  .chip[aria-pressed='true'] .num { color: #4a2f12; }
  .chip:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .gp__albums { display: grid; gap: clamp(56px, 7vw, 110px); }
  .alb { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); gap: 24px clamp(24px, 4vw, 64px); align-items: start; }
  .alb[hidden] { display: none; }
  .alb__head { position: sticky; top: 96px; display: grid; gap: 8px; padding-top: 4px; border-top: 1px solid var(--rule); }
  .alb__date { font-family: var(--display); font-size: clamp(34px, 3.4vw, 48px); color: var(--acc); line-height: 1; margin-top: 18px; letter-spacing: -.01em; }
  .alb__head h2 { color: var(--head); }
  .alb__head :global(.alb__sc) { font-size: 18px; color: var(--brass-hi); }
  .alb__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: clamp(8px, 1.2vw, 16px); }
  .tile { margin: 0; }
  .tile__btn { position: relative; display: block; width: 100%; aspect-ratio: 3 / 4; padding: 0; border: 0; border-radius: 3px; overflow: hidden; background: var(--soot); cursor: zoom-in; }
  .tile__btn img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2,.7,.2,1), filter .4s; }
  .tile__btn:hover img { transform: scale(1.04); filter: brightness(1.08); }
  .tile__btn:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .tile__play { position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px 0 8px; border-radius: 999px; background: rgba(14,11,8,.72); color: #f1e6d6; font: 500 13px/1 var(--body); }
  .tile__play svg { width: 18px; height: 18px; }
  .gp__more { margin-top: clamp(56px, 7vw, 96px); max-width: 52ch; }

  /* viewer */
  .lb { position: fixed; inset: 0; z-index: 80; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: #0a0806; color: #f1e6d6; }
  .lb[hidden] { display: none; }
  :global(html.lb-open) { overflow: hidden; }
  .lb__bar { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 12px 20px; padding: 14px var(--gutter); padding-top: max(14px, env(safe-area-inset-top)); }
  .lb__cap { margin: 0; font-size: 16px; color: #f1e6d6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb__n { margin: 0; color: #bfae95; font-size: 14px; }
  .lb__ctl { display: flex; gap: 8px; }
  .lb__stage { position: relative; display: grid; min-height: 0; overflow: hidden; padding: 0 clamp(8px, 6vw, 96px); touch-action: pan-y pinch-zoom; }
  /* fills the space between the bars and keeps the whole photo in view */
  .lb__stage :global(.lb__media) { width: 100%; height: 100%; min-height: 0; object-fit: contain; display: block; }
  .lb__alt { margin: 0; padding: 12px var(--gutter); padding-bottom: max(16px, env(safe-area-inset-bottom)); text-align: center; color: #bfae95; }
  .lb__nav { position: absolute; top: 50%; width: 52px; height: 52px; margin-top: -26px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(241,230,214,.25); background: rgba(14,11,8,.6); color: #f1e6d6; cursor: pointer; }
  .lb__nav[hidden] { display: none; }
  .lb__nav:hover { border-color: var(--acc); }
  .lb__nav:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .lb__nav svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; }
  .lb__nav--prev { left: clamp(8px, 2vw, 28px); }
  .lb__nav--next { right: clamp(8px, 2vw, 28px); }

  @media (max-width: 860px) {
    .alb { grid-template-columns: minmax(0, 1fr); }
    .alb__head { position: static; }
    .alb__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lb__bar { grid-template-columns: minmax(0, 1fr) auto; }
    .lb__n { grid-row: 2; }
    .lb__ctl { grid-column: 2; grid-row: 1 / 3; }
    .lb__stage { padding: 0; }
    .lb__alt { padding-inline: 64px; }
    .lb__nav { top: auto; bottom: max(12px, env(safe-area-inset-bottom)); width: 46px; height: 46px; margin-top: 0; }
    .lb__nav--prev { left: 8px; }
    .lb__nav--next { right: 8px; }
  }
</style>
