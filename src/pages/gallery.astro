---
import '@fontsource/hind/700.css';
import Base from '../layouts/Base.astro';
import Sc from '../components/Sc.astro';
import { albums, temple } from '../data/temple';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const m = (p: string) => `${base}media/${p}`;
// the temple's own naming: "Padi Pooja at Temple | 12-11-2026"
const dmy = (s: string) => s.split('-').reverse().join('-');
const longDate = (s: string) => new Intl.DateTimeFormat('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }).format(new Date(s + 'T00:00:00+05:30'));
const sorted = [...albums].sort((a, b) => b.date.localeCompare(a.date));
const KINDS = [
  { id: 'padi', label: 'Padi pooja', many: 'Padi poojas.' },
  { id: 'kanne', label: 'Kanne pooja', many: 'Kanne poojas.' },
  { id: 'festival', label: 'Festivals', many: 'Festivals.' },
] as const;
const kinds = KINDS.filter((k) => sorted.some((a) => a.kind === k.id));
// filter buttons only earn their place once there are enough albums to sort through
const showFilters = kinds.length > 1 && sorted.length >= 7;
const count = (type: 'photo' | 'video', list = sorted) => list.reduce((n, a) => n + a.items.filter((i) => i.type === type).length, 0);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
// an album of only videos says "6 videos", not "0 photos · 6 videos"
const counts = (list: typeof sorted) => [count('photo', list) ? plural(count('photo', list), 'photo') : '', count('video', list) ? plural(count('video', list), 'video') : ''].filter(Boolean).join(' · ');
// every item in page order, for the viewer
const items = sorted.flatMap((a) => a.items.map((it, n) => ({
  album: a.id, kind: a.kind, n: n + 1, of: a.items.length, type: it.type, src: m(it.src), poster: m(it.thumb), w: it.w, h: it.h, alt: it.alt,
  caption: `${a.title} | ${dmy(a.date)}`,
})));
// where each album's first item sits in that list
const starts = sorted.map((_, i) => sorted.slice(0, i).reduce((n, a) => n + a.items.length, 0));
const hero = sorted.flatMap((a) => a.items).find((i) => i.type === 'photo');
const latest = sorted[0];
// an album's cover: its first photo, or a video's poster
const cover = (al: (typeof sorted)[number]) => { const ph = al.items.find((i) => i.type === 'photo'); return ph ? { src: ph.src, thumb: ph.thumb } : { src: al.items[0].thumb, thumb: al.items[0].thumb }; };
// the opening film: the newest video that has a short silent loop cut from it (`loop` in temple.ts)
const film = (() => {
  for (let a = 0; a < sorted.length; a++) {
    const n = sorted[a].items.findIndex((i) => i.type === 'video' && i.loop);
    if (n >= 0) return { album: sorted[a], item: sorted[a].items[n], index: starts[a] + n };
  }
  return null;
})();
// an album shows at most this many full-screen photos while scrolling; the rest open in the viewer
const MAX = 6;
const two = (n: number) => String(n).padStart(2, '0');
const sendPhotos = `https://wa.me/${temple.whatsapp}?text=${encodeURIComponent('Swamiye Sharanam. I have photos from a pooja for the gallery.')}`;
---
<Base page="gallery" title="Gallery" description="Photos and videos of padi poojas, kanne poojas and festivals at the Ayyappa Swamy Temple, Kodathi, and at swamys’ homes." image={hero ? `media/${hero.src}` : undefined}>
  <!-- 1. The film shows through the word; scrolling goes through the letters into the picture -->
  <section class="gx-hero" data-gx-hero aria-labelledby="gx-h1">
    <div class="gx-hero__pin">
      <div class="gx-hero__media">
        {film
          ? <video muted loop playsinline preload="none" poster={m(film.item.loopPoster ?? film.item.thumb)} data-src={m(film.item.loop!)} data-gx-video aria-hidden="true" tabindex="-1"></video>
          : <img src={m(cover(latest).src)} alt="" fetchpriority="high" />}
      </div>
      <div class="gx-hero__mask" data-gx-mask>
        <h1 id="gx-h1" data-gx-word>Gallery</h1>
      </div>
      <!-- a fine outline keeps the word readable where the film is dark -->
      <div class="gx-hero__line" data-gx-mask aria-hidden="true"><span data-gx-word>Gallery</span></div>
      <span class="gx-hero__shade" data-gx-shade></span>
      <p class="gx-hero__cue" data-gx-cue aria-hidden="true"><span>Scroll</span><i></i></p>
      <div class="wrap gx-hero__end" data-gx-end>
        {film ? (
          <>
            <p class="gx-hero__k">Now showing</p>
            <p class="gx-hero__name">{film.album.title} <span class="num">| {dmy(film.album.date)}</span></p>
            <button class="gx-btn gx-btn--lit" type="button" data-open={film.index} aria-label={`Watch with sound: ${film.album.title}, ${film.item.alt}`}><span>Watch with sound</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></i></button>
          </>
        ) : (
          <>
            <p class="gx-hero__k">Newest album</p>
            <p class="gx-hero__name">{latest.title} <span class="num">| {dmy(latest.date)}</span></p>
            <a class="gx-btn gx-btn--lit" href={`#album-${latest.id}`}><span>See the photos</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></i></a>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- 2. A quiet screen: what is in the gallery, said large, one line at a time -->
  <section class="gx-say" data-gx-say aria-label="About the gallery">
    <div class="wrap">
      <p class="gx-say__big">
        {kinds.map((k) => <span class="ln"><span data-ln>{k.many}</span></span>)}
      </p>
      <p class="gx-say__it" data-rise>At the temple and at swamys’ homes. A new album after every pooja.</p>
      <p class="gx-say__count num" data-gal-total data-rise>{plural(sorted.length, 'album')} · {counts(sorted)}</p>
    </div>
  </section>

  <!-- 3. The albums: one photo holds the middle of the screen; each album's photo slides up over the last as you scroll -->
  <section class="gx-index" data-gx-index aria-labelledby="gx-ix" style={`--n:${sorted.length}`}>
    <div class="gx-index__stage">
      <div class="wrap gx-index__in">
        <h2 class="gx-index__h" id="gx-ix">All albums</h2>
        {showFilters && (
          <div class="gp__filters" role="group" aria-label="Show albums">
            <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="num">{sorted.length}</span></button>
            {kinds.map((k) => (
              <button class="chip" type="button" data-filter={k.id} aria-pressed="false">{k.label} <span class="num">{sorted.filter((x) => x.kind === k.id).length}</span></button>
            ))}
          </div>
        )}
        <ol class="gx-list" data-ix-list>
          {sorted.map((al, i) => (
            <li data-ix={al.id} data-kind={al.kind} class={i === 0 ? 'is-on' : undefined} style={`--i:${i}`}>
              <a href={`#album-${al.id}`} aria-label={`${al.title}, ${dmy(al.date)}, ${counts([al])}: see the album`}>
                <span class="gx-list__card" data-ix-card><img class={i === 0 ? 'is-on' : undefined} src={m(cover(al).thumb)} srcset={`${m(cover(al).thumb)} 640w, ${m(cover(al).src)} 1200w`} sizes="(max-width: 860px) 64vw, 420px" alt="" data-ix-bg={al.id} loading="lazy" width="480" height="640" /></span>
                <span class="gx-list__cap">
                  <span class="gx-list__n num">{two(i + 1)} / {two(sorted.length)}</span>
                  <span class="gx-list__t">{al.title}</span>
                  <span class="gx-list__d num">{dmy(al.date)} · {counts([al])}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 4. Each album fills the screen; its photos peel away one by one as you scroll -->
  <section class="gp" aria-label="Albums">
    <div class="gp__albums">
      {sorted.map((al, ai) => {
        const shown = al.items.slice(0, MAX);
        return (
          <article class="alb" id={`album-${al.id}`} data-album={al.id} data-kind={al.kind} aria-labelledby={`t-${al.id}`} style={`--n:${shown.length}`}>
            <div class="alb__stage" data-stage>
              <ul class="alb__grid" data-rail>
                {shown.map((it, n) => {
                  const i = starts[ai] + n;
                  return (
                    <li class={`tile tile--${it.type}${it.w > it.h ? ' tile--wide' : ''}`} style={`--i:${n}`}>
                      <button type="button" class="tile__btn" data-open={i} style={it.w > it.h ? `background-image:url(${m(it.thumb)})` : undefined} aria-label={`Open ${it.type} ${n + 1} of ${al.items.length}, ${al.title}: ${it.alt}`}>
                        <img src={m(it.thumb)} srcset={it.type === 'photo' ? `${m(it.thumb)} 640w, ${m(it.src)} ${it.w}w` : undefined} sizes={it.type === 'photo' ? '(max-width: 860px) 100vw, 50vw' : undefined} alt="" loading="lazy" width={it.w} height={it.h} data-par />
                        {it.type === 'video' && <span class="tile__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>Video</span>}
                      </button>
                    </li>
                  );
                })}
              </ul>
              <span class="alb__scrim" aria-hidden="true"></span>
              <div class="wrap alb__foot">
                <header class="alb__head">
                  <p class="alb__date num"><time datetime={al.date}>{dmy(al.date)}</time></p>
                  <h2 class="alb__t" id={`t-${al.id}`}>{al.title}</h2>
                  <Sc tag="p" kn={al.kn} te={al.te} class="alb__sc" />
                  <p class="small">{longDate(al.date)} · {counts([al])}</p>
                </header>
                <div class="alb__meta">
                  <span class="alb__pills" aria-hidden="true">{shown.map((_, n) => <i class={n === 0 ? 'is-on' : undefined}></i>)}</span>
                  <span class="num alb__n" data-rail-n aria-hidden="true">01 / {two(shown.length)}</span>
                  <button class="gx-btn gx-btn--lit alb__open" type="button" data-stage-open aria-label={`Open the photo on screen, ${al.title}`}><span>Open</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></i></button>
                </div>
                {al.items.length > MAX && <button class="alb__more" type="button" data-open={starts[ai] + MAX}>See all {al.items.length} in this album</button>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- 5. A quiet close -->
  <section class="gx-out" aria-labelledby="gx-out-h">
    <div class="wrap">
      <h2 class="gx-out__h" id="gx-out-h"><span class="ln"><span data-ln>Have photos</span></span><span class="ln"><span data-ln>from a pooja?</span></span></h2>
      <p class="gp__more" data-rise>Send them to the temple on WhatsApp with the pooja’s name and date, and we’ll add an album.</p>
      <a class="gx-btn" href={sendPhotos} target="_blank" rel="noopener" data-rise><span>Send on WhatsApp</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></i></a>
    </div>
  </section>

  <!-- Full-screen viewer -->
  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-labelledby="lb-cap">
    <div class="lb__bar">
      <p class="lb__cap" id="lb-cap" data-lb-cap></p>
      <p class="lb__n num" data-lb-n aria-live="polite"></p>
      <div class="lb__ctl">
        <button class="pill" type="button" data-lb-share>Share</button>
        <button class="pill" type="button" data-lb-close>Close</button>
      </div>
    </div>
    <div class="lb__stage" data-lb-stage></div>
    <p class="lb__alt small" data-lb-alt></p>
    <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
    <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
  </div>
  <script type="application/json" id="gal-items" set:html={JSON.stringify(items)} />
</Base>

<script>
  import { tr } from '../i18n';

  import { getLenis, sound, reduced, gsap, ScrollTrigger } from '../scripts/core';

  type Item = { album: string; kind: string; n: number; of: number; type: 'photo' | 'video'; src: string; poster: string; w: number; h: number; alt: string; caption: string };
  const items: Item[] = JSON.parse(document.getElementById('gal-items')!.textContent || '[]');
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

  /* ---------- filters ---------- */
  let filter = 'all';
  const visible = () => items.map((_, i) => i).filter((i) => filter === 'all' || items[i].kind === filter);
  $$<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.filter!;
    $$('[data-filter]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    $$('[data-album], [data-ix]').forEach((a) => { a.hidden = filter !== 'all' && a.dataset.kind !== filter; });
    ScrollTrigger.refresh();
    getLenis()?.resize();
  }));

  /* ---------- viewer ---------- */
  const lb = $('[data-lb]'), stage = $('[data-lb-stage]');
  let list: number[] = [], at = 0, opener: HTMLElement | null = null;

  function render() {
    const it = items[list[at]];
    stage.querySelector('video')?.pause();
    stage.replaceChildren();
    if (it.type === 'photo') {
      const img = new Image();
      img.src = it.src; img.alt = tr(it.alt); img.width = it.w; img.height = it.h; img.decoding = 'async';
      img.className = 'lb__media';
      stage.append(img);
    } else {
      const v = document.createElement('video');
      v.src = it.src; v.poster = it.poster; v.controls = true; v.playsInline = true; v.autoplay = true; v.className = 'lb__media';
      v.setAttribute('aria-label', tr(it.alt)); v.width = it.w; v.height = it.h;
      // the chant steps back while a video plays with its own sound
      v.addEventListener('play', () => sound.duck(0.06));
      v.addEventListener('pause', () => sound.duck(0.55));
      stage.append(v);
    }
    $('[data-lb-cap]').textContent = tr(it.caption);
    $('[data-lb-n]').textContent = tr(`${at + 1} of ${list.length}`);
    $('[data-lb-alt]').textContent = tr(it.alt);
    const one = list.length < 2;
    ($('[data-lb-prev]') as HTMLButtonElement).hidden = one;
    ($('[data-lb-next]') as HTMLButtonElement).hidden = one;
    history.replaceState(history.state, '', `#${it.album}/${it.n}`);
    // warm the neighbours so swiping feels instant
    [list[(at + 1) % list.length], list[(at - 1 + list.length) % list.length]].forEach((j) => { if (items[j].type === 'photo') new Image().src = items[j].src; });
    if (!reduced) stage.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' });
  }
  function open(i: number, from?: HTMLElement, push = true) {
    // Android back button closes the viewer rather than leaving the gallery
    if (push) history.pushState({ lb: true }, '', location.pathname + location.search);
    list = visible().includes(i) ? visible() : items.map((_, j) => j);
    at = list.indexOf(i);
    opener = from ?? null;
    lb.hidden = false;
    // the viewer settles in from slightly small
    if (!reduced) lb.animate([{ opacity: 0, transform: 'scale(.95)' }, { opacity: 1, transform: 'none' }], { duration: 380, easing: 'cubic-bezier(.22,1,.36,1)' });
    document.documentElement.classList.add('lb-open');
    getLenis()?.stop();
    render();
    $<HTMLButtonElement>('[data-lb-close]').focus();
  }
  function close() {
    if (history.state?.lb) { history.back(); return; }
    shut();
  }
  window.addEventListener('popstate', () => { if (!lb.hidden) shut(); });
  function shut() {
    stage.querySelector('video')?.pause();
    stage.replaceChildren();
    sound.duck(0.55);
    lb.hidden = true;
    document.documentElement.classList.remove('lb-open');
    getLenis()?.start();
    history.replaceState(null, '', location.pathname + location.search);
    opener?.focus();
  }
  const go = (d: number) => { at = (at + d + list.length) % list.length; render(); };

  $$<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.open), b)));
  $('[data-lb-close]').addEventListener('click', close);
  $('[data-lb-prev]').addEventListener('click', () => go(-1));
  $('[data-lb-next]').addEventListener('click', () => go(1));
  // a click on the dark around the photo closes, as people expect
  stage.addEventListener('click', (e) => { if (e.target === stage) close(); });

  $('[data-lb-share]').addEventListener('click', async () => {
    const it = items[list[at]];
    const url = location.href;
    if (navigator.share) { try { await navigator.share({ title: it.caption, url }); } catch (e) {} return; }
    window.open(`https://wa.me/?text=${encodeURIComponent(`${it.caption} ${url}`)}`, '_blank', 'noopener');
  });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowRight') go(1);
    else if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === 'Tab') {
      // keep focus inside the viewer
      const f = $$<HTMLElement>('button:not([hidden]), video', lb);
      const i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  });

  // swipe left and right on phones; a drag that starts on a video's controls is left alone
  let sx = 0, sy = 0, track = false;
  stage.addEventListener('pointerdown', (e) => {
    const v = (e.target as HTMLElement).closest('video');
    track = e.pointerType !== 'mouse' && !(v && e.clientY > v.getBoundingClientRect().bottom - 64);
    sx = e.clientX; sy = e.clientY;
  });
  stage.addEventListener('pointerup', (e) => {
    if (!track) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) go(dx < 0 ? 1 : -1);
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.4) close();
    track = false;
  });

  // a shared link opens straight on its photo: /gallery/#<album>/<n>
  const m = location.hash.match(/^#(.+)\/(\d+)$/);
  if (m) {
    const i = items.findIndex((it) => it.album === decodeURIComponent(m[1]) && it.n === Number(m[2]));
    if (i >= 0) open(i, $<HTMLElement>(`[data-open="${i}"]`), false);
  }
</script>

<script>
  import { tr } from '../i18n';

  // Gallery motion. Phones first: everything is driven by scroll and tap, nothing needs hover.
  import { gsap, ScrollTrigger, reduced, getLenis } from '../scripts/core';
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const motion = !reduced;
  if (motion) document.documentElement.classList.add('gx-motion');

  /* 1. hero: the film plays inside the word; scrolling flies through the letters into the picture */
  const hero = document.querySelector<HTMLElement>('[data-gx-hero]');
  const film = document.querySelector<HTMLVideoElement>('[data-gx-video]');
  // people on data saver keep the still picture
  const saver = (navigator as any).connection?.saveData === true;
  if (film && motion && !saver) {
    film.src = film.dataset.src!;
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) film.play().catch(() => {}); else film.pause(); }, { threshold: 0.05 });
    io.observe(film);
  }
  if (hero && motion) {
    gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.5 } })
      .to('[data-gx-word]', { scale: 16, ease: 'power2.in', duration: 0.7 }, 0)
      .to('[data-gx-cue]', { opacity: 0, duration: 0.1 }, 0)
      .to('[data-gx-mask]', { opacity: 0, duration: 0.3 }, 0.38)
      .set('[data-gx-mask]', { visibility: 'hidden' }, 0.7)
      .fromTo('[data-gx-shade]', { opacity: 0 }, { opacity: 1, duration: 0.2 }, 0.66)
      .fromTo('[data-gx-end]', { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.2 }, 0.72);
  } else hero?.classList.add('is-static');

  /* 2. big lines rise one after another */
  if (motion) {
    $$('.gx-say, .gx-out').forEach((sec) => {
      gsap.from($$('[data-ln]', sec), { yPercent: 110, duration: 1.1, ease: 'expo.out', stagger: 0.09, scrollTrigger: { trigger: sec, start: 'top 72%', once: true } });
    });
  }

  /* 3. index: one photo holds the middle of the screen; each album's photo slides up over the last */
  const index = document.querySelector<HTMLElement>('[data-gx-index]');
  const rows = $$('[data-ix]');
  if (motion && index && rows.length) {
    let on = -1;
    const sync = (prog: number) => {
      const live = rows.filter((r) => !r.hidden);
      const p = prog * (live.length - 1);
      live.forEach((r, i) => {
        const cardEl = r.querySelector<HTMLElement>('[data-ix-card]')!, img = cardEl.firstElementChild as HTMLElement;
        const k = i === 0 ? 1 : clamp(p - (i - 1));       // how far this photo has come up
        const out = clamp(p - i);                          // how far the next has covered it
        cardEl.style.clipPath = k < 1 ? `inset(${(1 - k) * 100}% 0 0 0)` : '';
        img.style.transform = `translate3d(0, ${(1 - k) * 22 - out * 10}%, 0) scale(${1.02 + (1 - k) * 0.16})`;
      });
      const c = clamp(Math.round(p), 0, live.length - 1);
      if (c !== on) {
        on = c;
        rows.forEach((r) => r.classList.toggle('is-on', r === live[c]));
        $$('[data-ix-bg]').forEach((im) => im.classList.toggle('is-on', im.dataset.ixBg === live[c].dataset.ix));
      }
    };
    ScrollTrigger.create({ trigger: index, start: 'top top', end: 'bottom bottom', onUpdate: (st) => sync(st.progress), onRefresh: (st) => { on = -1; sync(st.progress); } });
    // the photo arrives small and settles as the screen pins
    gsap.fromTo('.gx-list', { scale: 0.72, opacity: 0.2 }, { scale: 1, opacity: 1, ease: 'none', scrollTrigger: { trigger: index, start: 'top 80%', end: 'top top', scrub: true } });
  }

  /* 4. albums: each fills the screen and its photos peel upward one by one */
  $$('[data-album]').forEach((album) => {
    const rail = album.querySelector<HTMLElement>('[data-rail]')!;
    const tiles = $$('.tile', rail);
    const pills = $$('.alb__pills i', album);
    const nEl = album.querySelector<HTMLElement>('[data-rail-n]')!;
    const n = tiles.length;
    const total = String(n).padStart(2, '0');
    let cur = 0, pos = 0;
    const set = (p: number) => {
      pos = p;
      tiles.forEach((t, i) => {
        const k = clamp(p - i);
        t.style.clipPath = k > 0 ? `inset(0 0 ${k * 100}% 0)` : '';
        // the photo leaving lifts a little; the one beneath settles from slightly large
        (t.querySelector('[data-par]') as HTMLElement).style.transform = `translate3d(0, ${-k * 7}%, 0) scale(${1 + clamp(i - p) * 0.14})`;
      });
      const c = clamp(Math.round(p), 0, n - 1);
      if (c !== cur || !nEl.dataset.ok) {
        cur = c; nEl.dataset.ok = '1';
        pills.forEach((el, i) => el.classList.toggle('is-on', i === c));
        nEl.textContent = tr(`${String(c + 1).padStart(2, '0')} / ${total}`);
      }
    };
    if (!motion) return;
    ScrollTrigger.create({ trigger: album, start: 'top top', end: 'bottom bottom', onUpdate: (s) => set(s.progress * (n - 1)), onRefresh: (s) => set(s.progress * (n - 1)) });
    // on phones the album arrives as a rounded card and opens to the whole screen
    if (matchMedia('(max-width: 860px)').matches) {
      gsap.fromTo(rail, { clipPath: 'inset(16% 9% 0% 9% round 30px)' }, { clipPath: 'inset(0% 0% 0% 0% round 0px)', ease: 'none', scrollTrigger: { trigger: album, start: 'top bottom', end: 'top top', scrub: true } });
    }
    gsap.from($$('.alb__head > *, .alb__meta', album), { y: 34, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.07, scrollTrigger: { trigger: album, start: 'top 35%', once: true } });

    // "Open" opens whichever photo is on screen
    album.querySelector('[data-stage-open]')?.addEventListener('click', () => tiles[cur].querySelector<HTMLButtonElement>('button')!.click());
    // reaching a photo with the keyboard brings it on screen
    // (after the browser's own scroll-to-focus, which only knows where the pinned screen is)
    tiles.forEach((t, i) => t.querySelector('button')!.addEventListener('focus', () => requestAnimationFrame(() => {
      if (n < 2) return;
      const y = album.getBoundingClientRect().top + window.scrollY + (i / (n - 1)) * (album.offsetHeight - window.innerHeight);
      if (Math.abs(window.scrollY - y) < 2) return;
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(y, { immediate: true, force: true }); else window.scrollTo(0, y);
    })));
  });
  ScrollTrigger.refresh();
  // the pinned albums made the page taller: tell the smooth scroller its new length straight away
  getLenis()?.resize();
</script>

