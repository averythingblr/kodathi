---
import Base from '../layouts/Base.astro';
import Sc from '../components/Sc.astro';
import { temple, schedule, steps, offerings, mandala } from '../data/temple';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const m = (p: string) => `${base}media/${p}`;
const fmt = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
const waMsg = (s: string) => `https://wa.me/${temple.whatsapp}?text=${encodeURIComponent(s)}`;
---
<Base page="home" footer={false}>
  <link slot="head" rel="preload" as="image" href={m('film/lamps-poster.jpg')} />

  <!-- Opening: one wick catches flame. The choice made here also starts the sound. -->
  <div class="pre" data-preloader role="dialog" aria-modal="true" aria-labelledby="pre-t">
    <div class="pre__lamp" aria-hidden="true">
      <div class="pre__glow"></div>
      <div class="pre__flame"></div>
      <div class="pre__wick"></div>
      <div class="pre__bowl"></div>
    </div>
    <p class="pre__chant sc" id="pre-t"><span lang="kn">{temple.chant.kn}</span><span lang="te">{temple.chant.te}</span></p>
    <p class="pre__status small num" data-pre-status aria-live="polite">Lighting the lamp</p>
    <div class="pre__go" data-pre-go>
      <button class="btn" type="button" data-enter="sound">Enter with sound</button>
      <button class="btn btn--ghost" type="button" data-enter="quiet">Enter quietly</button>
    </div>
  </div>

  <!-- Temple clock: scroll moves the day forward -->
  <div class="clock" data-clock aria-hidden="true">
    <span class="clock__t num" data-clock-t>04:30</span>
    <span class="clock__s" data-clock-s>Nada opens</span>
  </div>

  <!-- 04:30 · Lamps -->
  <section class="ch ch--film" id="nada" data-tone="night" data-time="04:30" data-scene="Nada opens" aria-labelledby="h-nada" style="--len:320svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/lamps.mp4')} data-src-m={m('film/lamps-m.mp4')} poster={m('film/lamps-poster.jpg')} muted playsinline preload="auto" aria-hidden="true"></video>
      <div class="veil veil--left"></div>
      <div class="chorus" data-chorus aria-hidden="true">
        {[temple.response.kn, temple.response.te, temple.response.en, temple.response.kn, temple.response.te].map((t, i) => (
          <p class={`chorus__row chorus__row--${i % 2 ? 'r' : 'l'}`}><span>{Array(8).fill(t).join('  ·  ')}</span></p>
        ))}
      </div>
      <div class="wrap stage__copy">
        <p class="kicker sc" lang="kn" data-hero-line>{temple.chant.kn}</p>
        <h1 class="t-hero" id="h-nada">
          <span class="line" data-hero-line>Swamiye&#32;</span>
          <span class="line" data-hero-line>Sharanam&#32;</span>
          <span class="line" data-hero-line>Ayyappa</span>
        </h1>
        <p class="kicker kicker--te sc" lang="te" data-hero-line>{temple.chant.te}</p>
        <p class="lede hero__sub" data-hero-sub>Every day at the temple in Kodathi begins in the dark, with a single lamp. Scroll to walk through one day, from the opening of the nada to Harivarasanam.</p>
      </div>
      <div class="scroll-cue small" data-cue aria-hidden="true"><span></span>Scroll</div>
    </div>
  </section>

  <!-- 05:00 · Doors open into light -->
  <section class="ch ch--film" id="doors" data-tone="night" data-time="05:00" data-scene="Nirmalyam darshan" aria-labelledby="h-doors" style="--len:300svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/doors.mp4')} data-src-m={m('film/doors-m.mp4')} poster={m('film/doors-poster.jpg')} muted playsinline preload="auto" aria-hidden="true"></video>
      <div class="veil veil--bottom"></div>
      <div class="wrap stage__copy stage__copy--low">
        <p class="time num">05:00</p>
        <h2 class="t-1" id="h-doors" data-doors-h>The nada opens</h2>
        <p class="lede" data-doors-p>The conch sounds, the doors part, and the first darshan of the day is the light itself.</p>
      </div>
      <div class="flood" data-flood aria-hidden="true"></div>
    </div>
  </section>

  <!-- 07:30 · The temple, in daylight -->
  <section class="ch day" id="temple" data-tone="day" data-time="07:30" data-scene="Usha pooja" aria-labelledby="h-temple">
    <svg class="kolam" data-kolam viewBox="0 0 600 600" aria-hidden="true"></svg>
    <div class="wrap day__intro">
      <p class="time num">07:30</p>
      <h2 class="t-1" id="h-temple" data-rise>A Sabarimala tradition on Kodati–Sulikunte Road</h2>
      <div class="day__cols">
        <p class="lede" data-rise>The Ayyappa Swamy Temple in Kodathi keeps the customs of Sabarimala close to home: the 41-day vratham, the irumudi, the eighteen steps and the padi pooja that lights them.</p>
        <p class="body-copy" data-rise>Devotees from Sarjapur, Varthur and the villages around come for the morning abhishekam, for annadanam at noon, and in the Mandala season for the evenings when every step is lit. The doors are open to everyone.</p>
      </div>
    </div>

    <div class="collage wrap" aria-label="Photos from the temple">
      <figure class="ph ph--a" data-speed="-0.06"><img src={m('temple/padi-lamps.jpg')} alt="The eighteen steps during padi pooja, a lamp burning on every step and garlands down the centre" loading="lazy" width="1050" height="1400" /><figcaption>Padi pooja, Mandala season</figcaption></figure>
      <figure class="ph ph--b" data-speed="0.07"><img src={m('temple/padi-day.jpg')} alt="Preparing the steps in the morning: lamps laid in rows, banana leaves and coconuts at the foot" loading="lazy" width="1050" height="1400" /><figcaption>Morning, laying the lamps</figcaption></figure>
      <figure class="ph ph--c" data-speed="-0.04"><img src={m('film/pilgrim-poster.jpg')} alt="" loading="lazy" width="1600" height="900" /><figcaption>The way to the hill</figcaption></figure>
      <figure class="ph ph--d" data-speed="0.08"><img src={m('temple/padi-night.jpg')} alt="Night view up the lit steps with flower garlands and devotees' raised hands" loading="lazy" width="960" height="1280" /><figcaption>After deeparadhana</figcaption></figure>
    </div>
  </section>

  <!-- 12:00 · Today at the temple (live) -->
  <section class="ch sandal" id="today" data-tone="sandal" data-time="12:00" data-scene="Ucha pooja" aria-labelledby="h-today">
    <div class="wrap today">
      <div class="today__head">
        <p class="time num">12:00</p>
        <h2 class="t-1" id="h-today">Today at the temple</h2>
        <p class="today__status" data-status aria-live="polite">
          <span class="dot" aria-hidden="true"></span><span data-status-text>The nada is open</span>
        </p>
        <p class="today__next" data-next>Next: <b>Ucha pooja</b> in <b class="num">1 h 10 min</b></p>
        <p class="placeholder-note">Timings are being confirmed by the temple.</p>
        <a class="btn btn--ghost" href={`${base}poojas/`}>All poojas and offerings</a>
      </div>
      <ol class="sched" data-sched>
        {schedule.map((p) => (
          <li class={`sched__row sched__row--${p.kind}`} data-at={p.at} data-dur={p.dur} data-id={p.id}>
            <span class="sched__t num">{fmt(p.at)}</span>
            <span class="sched__n">{p.name}<Sc tag="small" kn={p.kn} te={p.te} /></span>
            <span class="sched__d">{p.note}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 17:00 · Mandala season -->
  <section class="ch ch--mandala" id="mandala" data-tone="night" data-time="17:00" data-scene="Evening darshan" aria-labelledby="h-mandala">
    <video class="mandala__film" data-loop data-src={m('film/pilgrim.mp4')} data-src-m={m('film/pilgrim-m.mp4')} poster={m('film/pilgrim-poster.jpg')} muted playsinline loop preload="none" aria-hidden="true"></video>
    <div class="veil veil--left"></div>
    <div class="wrap mandala">
      <p class="time num">17:00</p>
      <h2 class="t-1" id="h-mandala" data-rise>Mandala season</h2>
      <p class="lede" data-rise>Forty-one days of vratham: the mala, black cloth, simple food, and the chant on every breath. It ends at the hill, with the irumudi carried up the eighteen steps.</p>
      <div class="vratham" data-vratham data-start={mandala.start} data-days={mandala.days}>
        <div class="vratham__beads" data-beads aria-hidden="true"></div>
        <p class="vratham__txt" data-vratham-txt aria-live="polite">The season begins on 17 November.</p>
      </div>
      <div class="makara" data-makara data-at={mandala.makaravilakku}>
        <p class="small">Makara Jyothi, 14 January 2027</p>
        <p class="makara__count num" aria-live="off"><span data-mk="d">00</span><small>days</small><span data-mk="h">00</span><small>hours</small><span data-mk="m">00</span><small>minutes</small></p>
      </div>
      <a class="btn btn--ghost" href={`${base}festivals/`}>Festival calendar</a>
    </div>
  </section>

  <!-- 18:30 · Offerings -->
  <section class="ch ch--offer" id="offerings" data-tone="kumkum" data-time="18:30" data-scene="Deeparadhana" aria-labelledby="h-offer">
    <div class="wrap offer">
      <div class="offer__media">
        <video data-loop data-src={m('film/aarti.mp4')} poster={m('film/aarti-poster.jpg')} muted playsinline loop preload="none" aria-hidden="true"></video>
        <p class="small">Deeparadhana: camphor aarti at dusk</p>
      </div>
      <div class="offer__list">
        <p class="time num">18:30</p>
        <h2 class="t-1" id="h-offer">Offerings</h2>
        <p class="lede">Book any offering on WhatsApp. The temple office will confirm the date and what to bring.</p>
        <ul class="acc">
          {offerings.map((o, i) => (
            <li class="acc__item">
              <h3>
                <button type="button" class="acc__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`of-${o.id}`} id={`ofb-${o.id}`}>
                  <span>{o.name}</span><Sc tag="small" kn={o.kn} te={o.te} /><i aria-hidden="true"></i>
                </button>
              </h3>
              <div class="acc__panel" id={`of-${o.id}`} role="region" aria-labelledby={`ofb-${o.id}`} hidden={i !== 0}>
                <p>{o.what}</p>
                <p class="small">{o.when}</p>
                <a class="btn" href={waMsg(`Swamiye Sharanam. I would like to book ${o.name}.`)} target="_blank" rel="noopener">Book {o.name} on WhatsApp</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 19:00 · Sharanam vili: call and response -->
  <section class="ch ch--vili" id="vili" data-tone="deep" data-time="19:00" data-scene="Sharanam vili" aria-labelledby="h-vili">
    <div class="vili__bands" aria-hidden="true" data-bands>
      <p class="band band--call" data-band="-1"><span>{[...temple.vili, ...temple.vili].map((v) => `${v.en}  ·  `).join('')}</span></p>
      <p class="band band--answer sc" data-band="1"><span>{Array(10).fill(`${temple.response.kn}  ·  ${temple.response.te}  ·  `).join('')}</span></p>
      <p class="band band--call band--sc sc" data-band="-0.7"><span>{[...temple.vili, ...temple.vili].map((v) => `${v.kn}  ·  ${v.te}  ·  `).join('')}</span></p>
    </div>
    <canvas class="vili__burst" data-burst aria-hidden="true"></canvas>
    <div class="wrap vili">
      <p class="time num">19:00</p>
      <h2 class="t-1" id="h-vili">One calls, everyone answers</h2>
      <p class="lede">Before the padi pooja the courtyard fills with sharanam vili. One devotee calls a name of Ayyappa, and every voice answers: Sharanam Ayyappa. Call, and hear the chorus answer you.</p>
      <div class="vili__stage">
        <p class="vili__call" data-call-text aria-live="polite"><span lang="en">{temple.vili[0].en}</span><Sc kn={temple.vili[0].kn} te={temple.vili[0].te} class="vili__call-sc" /></p>
        <p class="vili__answer" data-answer-text aria-hidden="true">{temple.response.en}</p>
        <button type="button" class="vili__btn" data-call>
          <span class="vili__ring" aria-hidden="true"></span>
          <span class="vili__lbl">Call</span>
          <span class="vili__sub" data-call-next>{temple.vili[0].en}</span>
        </button>
        <p class="small vili__count" data-call-count aria-live="polite">Press to call. Sound turns on with your first call.</p>
      </div>
    </div>
  </section>

  <!-- 19:30 · Padi pooja: the climb -->
  <section class="ch ch--film ch--climb" id="climb" data-tone="deep" data-time="19:30" data-scene="Padi pooja" aria-labelledby="h-climb" style="--len:760svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/climb.mp4')} data-src-m={m('film/climb-m.mp4')} poster={m('film/steps-poster.jpg')} muted playsinline preload="auto" aria-hidden="true"></video>
      <canvas class="embers" data-embers aria-hidden="true"></canvas>
      <div class="veil veil--climb"></div>
      <div class="wrap climb">
        <div class="climb__intro" data-climb-intro>
          <p class="time num">19:30</p>
          <h2 class="t-1" id="h-climb">Padi pooja</h2>
          <p class="lede">Eighteen steps lead to the sanctum. Each one is lit and worshipped in turn, and each one stands for something the pilgrim leaves behind on the way up.</p>
        </div>
        <div class="climb__step" data-climb-step aria-live="polite">
          <p class="climb__n num"><span data-step-n>01</span><small>of 18</small></p>
          <p class="climb__name" data-step-name>{steps[0].n}</p>
          <p class="climb__sk" data-step-sk>{steps[0].s}</p>
          <p class="climb__grp small" data-step-grp>The five senses</p>
        </div>
      </div>
      <ol class="rail" data-rail aria-hidden="true">
        {steps.map(() => <li></li>)}
      </ol>
      <div class="summit" data-summit>
        <Sc tag="p" kn="ಸನ್ನಿಧಾನ" te="సన్నిధానం" class="summit__sc" />
        <p class="t-2">At the eighteenth step, the sanctum.</p>
      </div>
    </div>
  </section>

  <!-- 19:50 · Darshan -->
  <section class="ch ch--film ch--darshan" id="darshan" data-tone="deep" data-time="19:50" data-scene="Darshan" aria-labelledby="h-darshan" style="--len:280svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/darshan.mp4')} data-src-m={m('film/darshan-m.mp4')} poster={m('film/darshan-poster.jpg')} muted playsinline preload="none" aria-label="Darshan of Lord Ayyappa in the sanctum"></video>
      <div class="veil veil--darshan"></div>
      <div class="wrap darshan">
        <div class="darshan__copy" data-darshan-copy>
          <Sc tag="p" kn="ಸನ್ನಿಧಾನ" te="సన్నిధానం" class="darshan__sc" />
          <h2 class="t-1" id="h-darshan">Darshan</h2>
          <p class="lede">Lord Ayyappa sits in yoga, knees bound by the yogapatta, his right hand raised to the devotee. Above the steps the words read <i>tat tvam asi</i>: you are that.</p>
        </div>
      </div>
      <p class="darshan__chorus t-hero" data-darshan-chorus aria-hidden="true">
        <span lang="kn">{temple.chant.kn}</span>
        <span lang="te">{temple.chant.te}</span>
      </p>
    </div>
  </section>

  <!-- Our padi pooja, real footage -->
  <section class="ch ch--real" id="ours" data-tone="deep" data-time="20:00" data-scene="Padi pooja" aria-labelledby="h-ours">
    <div class="wrap real">
      <div class="real__copy">
        <h2 class="t-2" id="h-ours" data-rise>And this is ours</h2>
        <p class="lede" data-rise>Padi pooja at the Kodathi temple, filmed by a devotee during last year’s Mandala season. No effects, no AI: the steps, the lamps and the chant as they are.</p>
        <button class="btn" type="button" data-real-sound>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
          <span data-real-label>Play with sound</span>
        </button>
      </div>
      <div class="real__frame" data-real-frame>
        <video data-real src={m('temple/padi.mp4')} poster={m('temple/padi-poster.jpg')} muted playsinline loop preload="none" width="480" height="854" aria-label="Padi pooja at the temple, video"></video>
      </div>
      <div class="real__numerals" aria-hidden="true" data-numerals>18</div>
    </div>
  </section>

  <!-- 20:30 · Visit -->
  <section class="ch ch--visit" id="visit" data-tone="night" data-time="20:30" data-scene="Athazha pooja" aria-labelledby="h-visit">
    <div class="wrap visit">
      <div>
        <p class="time num">20:30</p>
        <h2 class="t-1" id="h-visit" data-rise>Come for darshan</h2>
      </div>
      <dl class="visit__facts">
        <div data-rise><dt>Address</dt><dd>{temple.address.map((l) => <span>{l}</span>)}</dd></div>
        <div data-rise><dt>Open</dt><dd><span>4:30 to 12:30 in the morning</span><span>5:00 to 9:00 in the evening</span></dd></div>
        <div data-rise><dt>Contact</dt><dd><span>WhatsApp {temple.whatsappDisplay}</span><span class="small">Bookings, annadanam, group visits</span></dd></div>
      </dl>
      <div class="visit__cta" data-rise>
        <a class="btn" href={temple.mapUrl} target="_blank" rel="noopener">Directions in Google Maps</a>
        <a class="btn btn--ghost" href={`${base}visit/`}>Plan your visit</a>
      </div>
    </div>
  </section>

  <!-- 21:00 · Harivarasanam -->
  <section class="ch ch--film" id="hari" data-tone="night" data-time="21:00" data-scene="Harivarasanam" aria-labelledby="h-hari" style="--len:260svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/finale.mp4')} data-src-m={m('film/finale-m.mp4')} poster={m('film/finale-poster.jpg')} muted playsinline preload="none" aria-hidden="true"></video>
      <div class="veil veil--bottom"></div>
      <div class="wrap stage__copy stage__copy--low">
        <p class="time num">21:00</p>
        <h2 class="t-1" id="h-hari">Harivarasanam</h2>
        <p class="lede">Harivarasanam is sung and the nada closes for the night. Every lamp in the courtyard keeps burning until the doors open again at 4:30.</p>
      </div>
    </div>
  </section>

  <footer class="end" data-tone="night">
    <div class="wrap end__in">
      <p class="end__chant t-hero sc"><span lang="kn">{temple.chant.kn}</span><span lang="te">{temple.chant.te}</span></p>
      <div class="end__grid">
        <nav aria-label="Footer">
          <ul>
            <li><a href={`${base}poojas/`}>Poojas and timings</a></li>
            <li><a href={`${base}festivals/`}>Festivals</a></li>
            <li><a href={`${base}visit/`}>Visit</a></li>
          </ul>
        </nav>
        <address>
          {temple.address.map((l) => <span>{l}</span>)}
          <a href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a>
        </address>
        <p class="small">Film sequences and the darshan are AI-generated and art-directed. The photos and the padi pooja video are the temple’s own.</p>
      </div>
    </div>
  </footer>
</Base>

<style is:global>
  @property --bg { syntax: '<color>'; inherits: true; initial-value: #15110d; }
  @property --fg { syntax: '<color>'; inherits: true; initial-value: #e4c9a0; }
  @property --head { syntax: '<color>'; inherits: true; initial-value: #dad5cb; }
  @property --sub { syntax: '<color>'; inherits: true; initial-value: #9d9183; }
  @property --acc { syntax: '<color>'; inherits: true; initial-value: #ffc46a; }
  body[data-page='home'] { transition: --bg 1s var(--ease), --fg 1s var(--ease), --head 1s var(--ease), --sub 1s var(--ease), --acc 1s var(--ease); }
  body[data-tone='night'] { --bg: #15110d; --fg: #e4c9a0; --head: #dad5cb; --sub: #9d9183; --acc: #ffc46a; --rule: rgba(228,201,160,.18); }
  body[data-tone='day'] { --bg: #dad5cb; --fg: #2a241d; --head: #15110d; --sub: #6b6052; --acc: #a8261c; --rule: rgba(42,36,29,.2); }
  body[data-tone='sandal'] { --bg: #e4c9a0; --fg: #2a1d12; --head: #15110d; --sub: #6d5638; --acc: #8f2416; --rule: rgba(42,29,18,.22); }
  body[data-tone='kumkum'] { --bg: #6a1d14; --fg: #f6e3d0; --head: #fff1e2; --sub: #dcae9c; --acc: #ffc46a; --rule: rgba(246,227,208,.22); }
  body[data-tone='deep'] { --bg: #1d0d09; --fg: #ecd2b6; --head: #f4e4d0; --sub: #b48d7a; --acc: #ffc46a; --rule: rgba(236,210,182,.18); }
  body.is-gated { overflow: hidden; }
</style>

<style>
  /* preloader */
  .pre { position: fixed; inset: 0; z-index: 80; background: #0e0b08; display: grid; place-content: center; justify-items: center; gap: 22px; padding: 24px; text-align: center; transition: clip-path 1.1s var(--ease); clip-path: inset(0 0 0 0); }
  .pre.is-gone { clip-path: inset(0 0 100% 0); pointer-events: none; }
  .pre__lamp { position: relative; width: 120px; height: 170px; }
  .pre__bowl { position: absolute; left: 50%; bottom: 0; width: 96px; height: 34px; margin-left: -48px; border-radius: 0 0 60px 60px / 0 0 40px 40px; background: linear-gradient(180deg, #e2b65f, #8a6427 70%, #4d3612); box-shadow: inset 0 3px 0 rgba(255,236,190,.45); }
  .pre__wick { position: absolute; left: 50%; bottom: 30px; width: 4px; height: 16px; margin-left: -2px; background: #2b1d10; border-radius: 2px; }
  .pre__flame { position: absolute; left: 50%; bottom: 42px; width: 26px; height: 64px; margin-left: -13px; border-radius: 50% 50% 46% 46% / 64% 64% 36% 36%; background: radial-gradient(ellipse at 50% 78%, #fff6dc 0 18%, #ffd27a 38%, #ff9a2e 64%, rgba(255,120,30,0) 72%); transform-origin: 50% 100%; transform: scale(0); opacity: 0; filter: blur(.4px); }
  .pre__glow { position: absolute; left: 50%; bottom: 20px; width: 360px; height: 360px; margin-left: -180px; border-radius: 50%; background: radial-gradient(circle, rgba(255,180,80,.32), rgba(255,140,40,0) 62%); opacity: 0; }
  .is-lit .pre__flame { animation: ignite 1.4s var(--ease) forwards, flicker 2.2s 1.4s ease-in-out infinite; }
  .is-lit .pre__glow { animation: glow 2.4s var(--ease) forwards; }
  @keyframes ignite { 0% { transform: scale(0.05, 0.1); opacity: 0; } 30% { opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
  @keyframes flicker { 0%, 100% { transform: scale(1, 1) skewX(0); } 25% { transform: scale(.96, 1.05) skewX(1.5deg); } 50% { transform: scale(1.03, .97) skewX(-1deg); } 75% { transform: scale(.98, 1.03) skewX(.8deg); } }
  @keyframes glow { to { opacity: 1; } }
  .pre__chant { font-size: clamp(22px, 3vw, 34px); color: var(--flame); display: grid; gap: 4px; }
  .pre__chant span + span { font-size: .72em; color: #c9a873; }
  .pre__status { color: var(--dim); min-height: 1.5em; }
  .pre__go { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; opacity: 0; transform: translateY(10px); transition: opacity .6s var(--ease), transform .6s var(--ease); pointer-events: none; }
  .pre__go.is-ready { opacity: 1; transform: none; pointer-events: auto; }
  .pre .btn--ghost { color: var(--sandal); border-color: rgba(228,201,160,.3); }

  /* clock */
  .clock { position: fixed; left: var(--gutter); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 30; display: flex; align-items: center; gap: 10px; color: var(--head); pointer-events: none; transition: opacity .5s; padding: 8px 14px 6px; border-radius: 999px; background: color-mix(in srgb, var(--bg) 62%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--rule); }
  .clock__t { font-family: var(--display); font-size: 26px; line-height: 1; letter-spacing: -.01em; }
  .clock__s { font-size: 14px; color: var(--sub); }
  .is-gated .clock { opacity: 0; }

  /* chapters */
  .ch { position: relative; }
  .time { font-size: 15px; color: var(--acc); margin-bottom: 14px; letter-spacing: .02em; }
  .ch--film { height: var(--len, 300svh); }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: #0b0907; }
  .film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .veil { position: absolute; inset: 0; pointer-events: none; }
  .veil--left { background: linear-gradient(90deg, rgba(14,11,8,.86) 0%, rgba(14,11,8,.5) 38%, rgba(14,11,8,0) 70%), linear-gradient(0deg, rgba(14,11,8,.7), rgba(14,11,8,0) 30%); }
  .veil--bottom { background: linear-gradient(0deg, rgba(14,11,8,.9) 0%, rgba(14,11,8,.35) 40%, rgba(14,11,8,0) 65%); }
  .veil--climb { background: linear-gradient(90deg, rgba(20,9,6,.82) 0%, rgba(20,9,6,.3) 40%, rgba(20,9,6,0) 62%), linear-gradient(0deg, rgba(20,9,6,.55), rgba(20,9,6,0) 35%); }
  .stage__copy { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: center; padding-top: 80px; padding-bottom: 96px; color: #e4c9a0; }
  .stage__copy--low { justify-content: flex-end; }
  .stage__copy h1, .stage__copy h2 { color: #f1e6d6; }
  .stage__copy .lede { color: #e4c9a0; margin-top: 22px; }
  .kicker { color: var(--flame); font-size: clamp(17px, 1.7vw, 22px); }
  .kicker--te { margin-top: 18px; color: #c9a873; }
  .t-hero .line { display: block; }
  .hero__sub { max-width: 34ch; }
  .scroll-cue { position: absolute; right: var(--gutter-r); bottom: calc(22px + env(safe-area-inset-bottom, 0px)); display: flex; align-items: center; gap: 10px; color: #c9b79d; }
  .scroll-cue span { width: 1px; height: 38px; background: linear-gradient(#c9b79d, transparent); animation: cue 2s ease-in-out infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .flood { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 46%, #fff3d6 0%, #f4dfb4 30%, #dad5cb 70%); opacity: 0; pointer-events: none; }

  /* day */
  .day { padding-block: clamp(96px, 12vw, 160px) clamp(80px, 10vw, 140px); overflow: hidden; }
  .kolam { position: absolute; right: -4vw; top: 20px; width: min(56vw, 700px); height: auto; color: var(--brass); opacity: .55; pointer-events: none; }
  .day__intro { position: relative; }
  .day__intro h2 { max-width: 15ch; }
  .day__cols { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); margin-top: clamp(32px, 4vw, 56px); max-width: 1000px; }
  .collage { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(12px, 2vw, 28px); margin-top: clamp(64px, 9vw, 120px); align-items: start; }
  .ph { margin: 0; }
  .ph img { width: 100%; height: auto; object-fit: cover; background: var(--ash-2); }
  .ph figcaption { font-size: 14px; color: var(--sub); margin-top: 10px; }
  .ph--a { grid-column: 1 / span 4; }
  .ph--a img { aspect-ratio: 3 / 4; }
  .ph--b { grid-column: 6 / span 3; margin-top: 16vh; }
  .ph--b img { aspect-ratio: 3 / 4; }
  .ph--c { grid-column: 9 / span 4; margin-top: 4vh; }
  .ph--c img { aspect-ratio: 4 / 5; object-position: 46% 50%; }
  .ph--d { grid-column: 4 / span 5; margin-top: 10vh; }
  .ph--d img { aspect-ratio: 4 / 3; object-position: 50% 70%; }

  /* today */
  .sandal { padding-block: clamp(96px, 11vw, 150px); }
  .today { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .today__head { position: sticky; top: 110px; display: grid; gap: 18px; justify-items: start; }
  .today__status { display: inline-flex; align-items: center; gap: 10px; font-size: 19px; color: var(--head); margin-top: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #3c8a3a; box-shadow: 0 0 0 0 rgba(60,138,58,.5); animation: pulse 2s infinite; }
  .is-closed .dot { background: var(--sub); animation: none; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(60,138,58,0); } 100% { box-shadow: 0 0 0 0 rgba(60,138,58,0); } }
  .today__next { font-size: 19px; }
  .today__next b { font-weight: 500; color: var(--head); }
  .sched { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .sched__row { display: grid; grid-template-columns: 76px minmax(0, 1fr) minmax(0, 1.25fr); gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--rule); align-items: baseline; transition: background-color .4s, padding .4s var(--ease); }
  .sched__t { font-family: var(--display); font-size: 24px; color: var(--head); }
  .sched__n { font-size: 19px; font-weight: 500; color: var(--head); display: grid; }
  .sched__n :global(small) { font-weight: 400; font-size: 14px; color: var(--sub); }
  .sched__d { font-size: 15px; color: var(--fg); }
  .sched__row--close .sched__t, .sched__row--close .sched__n { color: var(--sub); }
  .sched__row.is-past { opacity: .5; }
  .sched__row.is-now { background: rgba(255,250,240,.45); padding-inline: 14px; margin-inline: -14px; border-radius: 4px; }
  .sched__row.is-now .sched__t::after { content: 'Now'; display: block; font-family: var(--body); font-size: 12px; color: var(--acc); letter-spacing: .04em; }
  .sched__row.is-next .sched__t::after { content: 'Next'; display: block; font-family: var(--body); font-size: 12px; color: var(--acc); letter-spacing: .04em; }

  /* mandala */
  .ch--mandala { min-height: 100svh; display: grid; align-items: center; overflow: hidden; background: #0e0b08; }
  .mandala__film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .9; }
  .mandala { position: relative; padding-block: 140px 120px; color: #e4c9a0; display: grid; gap: 22px; justify-items: start; }
  .mandala h2 { color: #f1e6d6; }
  .vratham { margin-top: 12px; display: grid; gap: 12px; }
  .vratham__beads { display: grid; grid-template-columns: repeat(21, 12px); gap: 7px; }
  .vratham__beads i { width: 12px; height: 12px; border-radius: 50%; background: rgba(228,201,160,.18); box-shadow: inset 0 -2px 0 rgba(0,0,0,.25); }
  .vratham__beads i.on { background: radial-gradient(circle at 35% 30%, #f3d38b, #b98a3e 60%, #6e4d1c); }
  .vratham__beads i.today { box-shadow: 0 0 0 3px rgba(255,196,106,.35), 0 0 16px #ffc46a; background: #ffc46a; }
  .vratham__txt { font-size: 17px; }
  .makara { display: grid; gap: 6px; margin-top: 8px; }
  .makara .small { color: #c9b79d; }
  .makara__count { font-family: var(--display); font-size: clamp(40px, 5vw, 64px); line-height: 1; color: #f1e6d6; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .makara__count small { font-family: var(--body); font-size: 14px; color: #c9b79d; margin-right: 14px; }

  /* offerings */
  .ch--offer { padding-block: clamp(96px, 11vw, 150px); }
  .offer { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .offer__media { position: sticky; top: 110px; display: grid; gap: 10px; }
  .offer__media video { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 42% 50%; border-radius: 2px; background: #3a120c; }
  .acc { list-style: none; margin: 36px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .acc__item { border-bottom: 1px solid var(--rule); }
  .acc h3 { font-family: var(--body); }
  .acc__btn { all: unset; box-sizing: border-box; width: 100%; cursor: pointer; display: grid; grid-template-columns: auto minmax(0, 1fr) 24px; align-items: baseline; gap: 12px; padding: 22px 0; font-family: var(--display); font-size: clamp(24px, 2.6vw, 34px); color: var(--head); }
  .acc__btn :global(small) { font-family: var(--script); font-size: 15px; color: var(--sub); }
  .acc__btn i { position: relative; width: 18px; height: 18px; justify-self: end; align-self: center; }
  .acc__btn i::before, .acc__btn i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform .4s var(--ease); }
  .acc__btn i::after { transform: rotate(90deg); }
  .acc__btn[aria-expanded='true'] i::after { transform: rotate(0); }
  .acc__btn:focus-visible { outline: 2px solid var(--acc); outline-offset: 4px; }
  .acc__panel { padding: 0 0 26px; display: grid; gap: 12px; justify-items: start; max-width: 56ch; }

  /* climb */
  .ch--climb .stage { background: #120806; }
  .embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; mix-blend-mode: screen; }
  .climb { position: relative; height: 100%; display: grid; grid-template-rows: 1fr auto; padding-top: 110px; padding-bottom: 100px; color: #ecd2b6; }
  .climb h2 { color: #f4e4d0; }
  .climb__intro { align-self: center; max-width: 520px; }
  .climb__intro .lede { margin-top: 20px; }
  .climb__step { opacity: 0; transform: translateY(24px); }
  .climb__n { font-family: var(--display); font-size: clamp(96px, 15vw, 220px); line-height: .8; color: #ffd690; letter-spacing: -.04em; text-shadow: 0 0 60px rgba(255,170,60,.35); display: flex; align-items: baseline; gap: 14px; }
  .climb__n small { font-family: var(--body); font-size: 15px; letter-spacing: 0; color: #c9a88a; text-shadow: none; }
  .climb__name { font-family: var(--display); font-size: clamp(30px, 3.4vw, 46px); color: #f4e4d0; margin-top: 8px; }
  .climb__sk { font-size: 18px; color: #e0b98d; font-style: italic; font-family: var(--display); }
  .climb__grp { color: #b48d7a; margin-top: 6px; }
  .rail { position: absolute; right: var(--gutter-r); top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column-reverse; gap: 9px; }
  .rail li { width: 22px; height: 2px; background: rgba(236,210,182,.25); transition: background-color .3s, width .3s var(--ease); }
  .rail li.on { background: #ffc46a; width: 30px; box-shadow: 0 0 10px rgba(255,196,106,.7); }
  .summit { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 14px; background: radial-gradient(ellipse at 50% 50%, rgba(255,246,222,.96) 0%, rgba(255,220,150,.9) 34%, rgba(29,13,9,.0) 75%); opacity: 0; pointer-events: none; color: #3b1a0c; padding: 24px; }
  .summit :global(.summit__sc) { font-size: clamp(20px, 2.4vw, 30px); color: #8f2416; }
  .summit .t-2 { color: #2a120a; font-family: var(--display); max-width: 18ch; margin: 0 auto; }

  /* real footage */
  .ch--real { padding-block: clamp(80px, 10vw, 140px); overflow: hidden; }
  .real { position: relative; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .real__copy { display: grid; gap: 22px; justify-items: start; position: relative; z-index: 1; }
  .real__frame { position: relative; z-index: 1; justify-self: center; width: min(100%, 420px); aspect-ratio: 9 / 16; border-radius: 6px; overflow: hidden; background: #2b100b; box-shadow: 0 40px 120px -30px rgba(255,150,60,.35); clip-path: inset(8% 12% 8% 12% round 6px); }
  .real__frame video { width: 100%; height: 100%; object-fit: cover; }
  .real__numerals { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-family: var(--display); font-size: clamp(240px, 30vw, 460px); line-height: .8; color: rgba(255,196,106,.07); pointer-events: none; letter-spacing: -.06em; }

  /* visit */
  .ch--visit { padding-block: clamp(96px, 11vw, 150px); }
  .visit { display: grid; gap: clamp(32px, 5vw, 56px); }
  .visit__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 0; border-top: 1px solid var(--rule); padding-top: 28px; }
  .visit__facts dt { font-size: 14px; color: var(--sub); margin-bottom: 8px; }
  .visit__facts dd { margin: 0; display: grid; gap: 2px; font-size: 19px; color: var(--head); }
  .visit__facts dd .small { font-size: 14px; }
  .visit__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* end */
  .end { background: #0b0907; color: #c9b79d; padding-block: clamp(80px, 10vw, 140px) 40px; }
  .end__chant { color: #f1e6d6; font-size: clamp(40px, 9vw, 150px); line-height: 1.1; margin: 0 0 clamp(48px, 7vw, 96px); }
  .end__chant span { display: block; }
  .end__chant span + span { color: #c9a873; font-size: .62em; margin-top: .2em; }
  .end__grid { display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 32px; border-top: 1px solid rgba(228,201,160,.14); padding-top: 28px; }
  .end__grid > * { min-width: 0; }
  .end ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .end a { color: #e4c9a0; text-underline-offset: 4px; }
  .end address { font-style: normal; display: grid; gap: 2px; }


  /* chorus: many voices behind the hero, swelling with the chant */
  .chorus { position: absolute; inset: 0; display: grid; align-content: center; gap: 1.2vh; overflow: hidden; pointer-events: none; opacity: calc(.045 + var(--amp, 0) * .16); transform: scale(calc(1 + var(--amp, 0) * .03)); transition: opacity .15s linear; }
  .chorus__row { margin: 0; white-space: nowrap; font-family: var(--script); font-size: clamp(40px, 7vw, 110px); line-height: 1.1; color: #ffd690; }
  .chorus__row span { display: inline-block; }
  .chorus__row--l span { animation: drift-l 90s linear infinite; }
  .chorus__row--r span { animation: drift-r 110s linear infinite; }
  @keyframes drift-l { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes drift-r { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  /* sharanam vili */
  .ch--vili { position: relative; overflow: hidden; padding-block: clamp(96px, 11vw, 150px); min-height: 100svh; display: grid; align-items: center; }
  .vili__bands { position: absolute; inset: 0; display: grid; align-content: space-around; pointer-events: none; }
  .band { margin: 0; white-space: nowrap; font-family: var(--display); font-size: clamp(36px, 6vw, 96px); line-height: 1; }
  .band span { display: inline-block; will-change: transform; }
  .band--call { color: rgba(185, 138, 62, .16); }
  .band--answer { color: rgba(255, 196, 106, .2); font-family: var(--script); }
  .band--sc { font-family: var(--script); font-size: clamp(30px, 4.6vw, 72px); }
  .vili__burst { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .vili { position: relative; display: grid; gap: 20px; justify-items: center; text-align: center; }
  .vili h2 { max-width: 14ch; }
  .vili .lede { max-width: 46ch; }
  .vili__stage { position: relative; display: grid; justify-items: center; gap: 14px; margin-top: 16px; min-height: 300px; align-content: center; }
  .vili__call { font-family: var(--display); font-size: clamp(30px, 4vw, 54px); color: #f4e4d0; min-height: 1.2em; display: grid; gap: 4px; }
  .vili__call :global(.vili__call-sc) { font-size: .5em; color: #c9a873; }
  .vili__answer { font-family: var(--display); font-size: clamp(44px, 7vw, 104px); line-height: 1; color: #ffc46a; text-shadow: 0 0 40px rgba(255,170,60,.5); opacity: 0; transform: scale(.9); }
  .vili__btn { all: unset; box-sizing: border-box; position: relative; width: 168px; height: 168px; border-radius: 50%; cursor: pointer; display: grid; place-content: center; text-align: center; gap: 4px; background: radial-gradient(circle at 50% 38%, #ffe2a8, #ffc46a 46%, #c98a2c); color: #2a1406; box-shadow: 0 20px 60px -10px rgba(255,160,50,.6), inset 0 -6px 12px rgba(120,60,10,.35); transition: transform .3s var(--ease); -webkit-tap-highlight-color: transparent; }
  .vili__btn:hover { transform: scale(1.04); }
  .vili__btn:active, .vili__btn.is-calling { transform: scale(.94); }
  .vili__btn:focus-visible { outline: 3px solid #ffe2a8; outline-offset: 6px; }
  .vili__lbl { font-family: var(--display); font-size: 34px; line-height: 1; }
  .vili__sub { font-size: 13px; max-width: 120px; line-height: 1.25; }
  .vili__ring { position: absolute; inset: -14px; border-radius: 50%; border: 1px solid rgba(255,196,106,.5); animation: ring 2.4s ease-out infinite; }
  @keyframes ring { from { transform: scale(.9); opacity: .9; } to { transform: scale(1.35); opacity: 0; } }
  .vili__count { color: #b48d7a; }

  /* darshan */
  .ch--darshan .stage { background: #120806; }
  .veil--darshan { background: linear-gradient(90deg, rgba(18,8,6,.85) 0%, rgba(18,8,6,.35) 34%, rgba(18,8,6,0) 55%), linear-gradient(0deg, rgba(18,8,6,.7), rgba(18,8,6,0) 30%); }
  .darshan { position: relative; height: 100%; display: flex; align-items: center; padding-top: 80px; padding-bottom: 80px; }
  .darshan__copy { max-width: 440px; color: #ecd2b6; }
  .darshan__copy h2 { color: #f4e4d0; }
  .darshan__copy .lede { margin-top: 18px; }
  .darshan__copy :global(.darshan__sc) { color: #ffc46a; font-size: clamp(18px, 1.8vw, 22px); margin-bottom: 10px; }
  .darshan__chorus { position: absolute; left: 0; right: 0; bottom: 6vh; text-align: center; margin: 0; font-family: var(--script); font-size: clamp(30px, 5vw, 76px); line-height: 1.1; color: #fff1d6; text-shadow: 0 0 30px rgba(255,170,60,.6); opacity: 0; pointer-events: none; }
  .darshan__chorus span { display: block; }
  .darshan__chorus span + span { font-size: .6em; color: #ffd690; }

  @media (max-width: 860px) {
    .day__cols, .today, .offer, .real { grid-template-columns: minmax(0, 1fr); }
    .today__head, .offer__media { position: static; }
    .collage { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .ph--a { grid-column: 1 / span 4; }
    .ph--b { grid-column: 3 / span 4; margin-top: 6vh; }
    .ph--c { grid-column: 1 / span 4; margin-top: 4vh; }
    .ph--d { grid-column: 2 / span 5; margin-top: 4vh; }
    .sched__row { grid-template-columns: 64px minmax(0, 1fr); }
    .sched__d { grid-column: 2; }
    .visit__facts, .end__grid { grid-template-columns: minmax(0, 1fr); }
    .offer__media video { aspect-ratio: 16 / 10; }
    .vratham__beads { grid-template-columns: repeat(14, 12px); gap: 6px; }
    .rail { gap: 6px; }
    .rail li { width: 14px; }
    .rail li.on { width: 20px; }
    .clock { left: auto; right: var(--gutter-r); padding: 6px 12px 4px; }
    .clock__t { font-size: 20px; }
    .clock__s { display: none; }
    .real__numerals { display: none; }
