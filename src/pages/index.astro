---
import Base from '../layouts/Base.astro';
import Sc from '../components/Sc.astro';
import { temple, terms, schedule, stairs, offerings, mandala, festivals, albums, address, kanneBrings } from '../data/temple';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const m = (p: string) => `${base}media/${p}`;
const fmt = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
const waMsg = (s: string) => `https://wa.me/${temple.whatsapp}?text=${encodeURIComponent(s)}`;
const longDate = (s: string) => new Intl.DateTimeFormat('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }).format(new Date(s + 'T00:00:00+05:30'));
const shortDate = (s: string) => new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' }).format(new Date(s + 'T00:00:00+05:30'));
const dated = festivals.filter((f) => !f.ongoing).sort((a, b) => a.start.localeCompare(b.start));
const ongoing = festivals.filter((f) => f.ongoing);
const both = (kn: string, te: string) => ({ kn, te });
const rows = [both(temple.response.kn, temple.response.te), null, both(temple.response.kn, temple.response.te), null, both(temple.response.kn, temple.response.te)];
---
<Base page="home" footer={false}>
  <link slot="head" rel="preload" as="image" href={m('film/lamps-poster.jpg')} />

  <!-- Opening: one wick catches flame. The choice made here also starts the sound. -->
  <div class="pre" data-preloader role="dialog" aria-modal="true" aria-labelledby="pre-t">
    <div class="pre__lamp" aria-hidden="true">
      <div class="pre__glow"></div>
      <div class="pre__flame"></div>
      <div class="pre__wick"></div>
      <div class="pre__bowl"></div>
    </div>
    <p class="pre__chant sc" id="pre-t"><span lang="kn" data-sc="kn">{temple.chant.kn}</span><span lang="te" data-sc="te">{temple.chant.te}</span><span class="sr-only">{temple.chant.en}</span></p>
    <p class="pre__status small num" data-pre-status aria-live="polite">Lighting the lamp</p>
    <div class="pre__go" data-pre-go>
      <button class="btn" type="button" data-enter="sound">Enter with sound</button>
      <button class="btn btn--ghost" type="button" data-enter="quiet">Enter quietly</button>
    </div>
  </div>

  <!-- The lamp is lit -->
  <section class="ch ch--film" id="nada" data-tone="night" aria-labelledby="h-nada" style="--len:200svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/lamps.mp4')} data-src-m={m('film/lamps-m.mp4')} poster={m('film/lamps-poster.jpg')} muted playsinline preload="auto" aria-hidden="true"></video>
      <div class="veil veil--left"></div>
      <div class="chorus" data-chorus aria-hidden="true">
        {rows.map((r, i) => (
          <p class={`chorus__row chorus__row--${i % 2 ? 'r' : 'l'}`}>
            {r ? (<><span data-sc="kn">{Array(8).fill(r.kn).join('  ·  ')}</span><span data-sc="te">{Array(8).fill(r.te).join('  ·  ')}</span></>) : <span>{Array(8).fill(temple.response.en).join('  ·  ')}</span>}
          </p>
        ))}
      </div>
      <div class="wrap stage__copy">
        <p class="kicker sc" data-hero-line><span lang="kn" data-sc="kn">{temple.chant.kn}</span><span lang="te" data-sc="te">{temple.chant.te}</span></p>
        <h1 class="t-hero" id="h-nada">
          <span class="line" data-hero-line>Swamiye&#32;</span>
          <span class="line" data-hero-line>Sharanam&#32;</span>
          <span class="line" data-hero-line>Ayyappa</span>
        </h1>
        <p class="lede hero__sub" data-hero-sub>Every day at the temple in Kodathi begins in the dark, with a single lamp. Scroll through the day, from the first darshan to Harivarasanam.</p>
      </div>
      <div class="scroll-cue small" data-cue aria-hidden="true"><span></span>Scroll</div>
    </div>
  </section>

  <!-- The sanctum doors open onto the idol -->
  <section class="ch ch--film" id="doors" data-tone="night" aria-labelledby="h-doors" style="--len:260svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/nada.mp4')} data-src-m={m('film/nada-m.mp4')} poster={m('film/doors-poster.jpg')} muted playsinline preload="auto" aria-label="The sanctum doors open onto Lord Ayyappa"></video>
      <div class="veil veil--bottom"></div>
      <div class="wrap stage__copy stage__copy--low">
        <h2 class="t-1" id="h-doors" data-doors-h>The sanctum opens</h2>
        <p class="lede" data-doors-p>The conch sounds and the doors open for the first pooja of the day, at five in the morning.</p>
      </div>
      <div class="wrap stage__copy stage__copy--low nirmalyam" data-nirmalyam>
        <h2 class="t-1">Swamiye Sharanam Ayyappa</h2>
        <p class="lede">The first darshan of the day.</p>
      </div>
      <div class="flood" data-flood aria-hidden="true"></div>
    </div>
  </section>

  <!-- Now and next -->
  <section class="ch nowbar" id="now" data-tone="day" aria-label="The temple now">
    <div class="wrap nowbar__in">
      <p class="nowbar__status" data-now-status><span class="dot" aria-hidden="true"></span><span data-now-status-text>The temple is open</span></p>
      <p class="nowbar__next" data-now-next>Next: <b>Evening pooja</b> at <b class="num">19:00</b></p>
      <div class="nowbar__cta">
        <a class="btn" href={temple.mapUrl} target="_blank" rel="noopener">Directions</a>
        <a class="btn btn--ghost" href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Today at the temple (live) -->
  <section class="ch sandal" id="today" data-tone="sandal" aria-labelledby="h-today">
    <div class="wrap today">
      <div class="today__head">
        <h2 class="t-1" id="h-today">Today at the temple</h2>
        <p class="today__status" data-status aria-live="polite">
          <span class="dot" aria-hidden="true"></span><span data-status-text>The temple is open</span>
        </p>
        <p class="today__next" data-next>Next: <b>Evening pooja</b> in <b class="num">5 h 00 min</b></p>
        <p class="today__open">The temple is open all day during the season.</p>
        <p class="placeholder-note">Timings are being confirmed by the temple.</p>
        <a class="btn btn--ghost" href={`${base}poojas/`}>All poojas and sevas</a>
      </div>
      <ol class="sched" data-sched>
        {schedule.map((p) => (
          <li class={`sched__row sched__row--${p.kind}`} data-at={p.at} data-dur={p.dur} data-id={p.id} data-name={p.name}>
            <span class="sched__t num">{fmt(p.at)}</span>
            <span class="sched__n">{p.name}<Sc tag="small" kn={p.kn} te={p.te} /></span>
            <span class="sched__d">{p.note}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Maala dharana: going on, and each swamy's own day of 41 -->
  <section class="ch ch--mandala" id="mala" data-tone="night" aria-labelledby="h-mala">
    <video class="mandala__film" data-loop data-src={m('film/pilgrim.mp4')} data-src-m={m('film/pilgrim-m.mp4')} poster={m('film/pilgrim-poster.jpg')} muted playsinline loop preload="none" aria-hidden="true"></video>
    <div class="veil veil--left"></div>
    <div class="wrap mandala">
      <Sc tag="p" kn={terms.mala.kn} te={terms.mala.te} class="mala__sc" />
      <h2 class="t-1" id="h-mala" data-rise>Maala dharana</h2>
      <p class="lede" data-rise>Maala dharana is going on since Monday 9 November 2026. Each swamy’s 41 days begin on the day they take the mala from a guruswamy.</p>
      <div class="vratham" data-vratham data-days={mandala.days} data-from={mandala.malaFrom}>
        <label class="vratham__q" for="mala-date">The day you took the mala</label>
        <input class="vratham__in" id="mala-date" type="date" data-mala-date min="2026-09-01" />
        <div class="vratham__beads" data-beads aria-hidden="true"></div>
        <p class="vratham__txt" data-vratham-txt aria-live="polite">Enter the day you took the mala to see your day of 41.</p>
      </div>
      <p class="mala__address">In deeksha, everyone is called by Ayyappa’s names:
        {address.map((a, i) => (<>{i ? (i === address.length - 1 ? ' and ' : ', ') : ' '}{a.who.toLowerCase()} are <b>{a.en}</b><Sc kn={a.kn} te={a.te} class="mala__term" /></>))}.
      </p>
      <details class="kanne" data-kanne>
        <summary>Taking the mala for the first time? What a kanne swamy brings <Sc kn={terms.kanne.kn} te={terms.kanne.te} class="kanne__sc" /></summary>
        <ul class="kanne__list">
          {kanneBrings.map(([h, p]) => (<li><b>{h}</b><span>{p}</span></li>))}
        </ul>
        <p class="small">From the Sri Sastha Devasthanam, Khammam. Your guruswamy will tell you if anything differs.</p>
      </details>
      <div class="makara" data-makara data-at={mandala.darshan}>
        <p class="small">Until Mandala pooja darshan, 27 December 2026<Sc kn="ಮಂಡಲ ಪೂಜೆ" te="మండలపూజ" class="makara__sc" /></p>
        <p class="makara__count num" aria-live="off"><span data-mk="d">00</span><small>days</small><span data-mk="h">00</span><small>hours</small><span data-mk="m">00</span><small>minutes</small></p>
      </div>
    </div>
  </section>

  <!-- Coming up -->
  <section class="ch upcoming" id="coming" data-tone="night" aria-labelledby="h-coming">
    <div class="wrap">
      <h2 class="t-2" id="h-coming">Coming up</h2>
      <ol class="up" data-up>
        {ongoing.map((f) => (
          <li class="up__row up__row--now">
            <p class="up__when">Going on</p>
            <div><h3>{f.name} <Sc kn={f.kn} te={f.te} class="up__sc" /></h3><p>{f.about}</p></div>
          </li>
        ))}
        <li class="up__row">
          <p class="up__when">Thursday evenings</p>
          <div><h3>Padi pooja <Sc kn={terms.padi.kn} te={terms.padi.te} class="up__sc" /></h3><p>At the temple on Thursday evenings, and at your home on request. Ask on WhatsApp for the next date.</p></div>
        </li>
        {dated.map((f) => (
          <li class="up__row" data-up-date={f.start} hidden>
            <p class="up__when"><span>{shortDate(f.start)}</span><small class="num" data-up-in></small></p>
            <div><h3>{f.name} <Sc kn={f.kn} te={f.te} class="up__sc" /></h3><p>{f.about}</p></div>
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href={`${base}festivals/`}>Events and festivals</a>
    </div>
  </section>

  <!-- The temple, in daylight, and its own photos -->
  <section class="ch day" id="temple" data-tone="day" aria-labelledby="h-temple">
    <svg class="kolam" data-kolam viewBox="0 0 600 600" aria-hidden="true"></svg>
    <div class="wrap day__intro">
      <h2 class="t-1" id="h-temple" data-rise>A Sabarimala tradition on Kodati–Sulikunte Road</h2>
      <div class="day__cols">
        <p class="lede" data-rise>The Ayyappa Swamy Temple in Kodathi keeps the customs of Sabarimala close to home: the 41-day vow, maala dharana, the irumudi, and the padi pooja that lights the eighteen steps.</p>
        <p class="body-copy" data-rise>Swamys from Sarjapur, Varthur and the villages around come for the morning abhishekam and for annadanam at noon. On padi pooja evenings every step is lit. The doors are open to everyone.</p>
      </div>
    </div>

    <div class="wrap gal" aria-labelledby="h-gal">
      <h2 class="t-2" id="h-gal">From the gallery</h2>
      {albums.map((a) => (
        <article class="gal__album" data-album={a.id}>
          <header class="gal__head">
            <h3>{a.title}</h3>
            <Sc tag="p" kn={a.kn} te={a.te} class="gal__sc" />
            <p class="small"><time datetime={a.date}>{longDate(a.date)}</time> · {a.items.filter((i) => i.type === 'photo').length} photos{a.items.some((i) => i.type === 'video') && ` · ${a.items.filter((i) => i.type === 'video').length} videos`}</p>
          </header>
          <ul class="gal__grid">
            {a.items.map((it) => (
              <li class={`gal__tile gal__tile--${it.type}`}>
                {it.type === 'photo'
                  ? <img src={m(it.thumb)} alt={it.alt} loading="lazy" width="480" height="640" />
                  : (<>
                      <video data-gal-video data-src={m(it.src)} poster={m(it.thumb)} muted playsinline loop preload="none" aria-label={it.alt}></video>
                      <button class="gal__snd" type="button" data-gal-sound aria-pressed="false"><span data-gal-label>Play with sound</span></button>
                    </>)}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Priests and guruswamys -->
  <section class="ch swamis" id="swamis" data-tone="day" aria-labelledby="h-swamis">
    <div class="wrap">
      <Sc tag="p" kn={terms.guruswamy.kn} te={terms.guruswamy.te} class="swamis__sc" />
      <h2 class="t-2" id="h-swamis">Our Guruswamys and Swamys</h2>
      <p class="lede">Our guruswamys lead the deeksha. Go to them for maala dharana and to tie your irumudi.</p>
      <ul class="swamis__row">
        {[
          { role: 'Chief Guruswamy', note: 'Wearing the mala since 1998' },
          { role: 'Guruswamy', note: '' },
          { role: 'Our swamys', note: 'This season’s swamys' },
        ].map((r) => (
          <li class="swami"><span class="swami__ph" aria-hidden="true"></span><b>{r.role}</b><span>{r.note}</span><span class="small">Name and photo to come from the temple</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sevas -->
  <section class="ch ch--offer" id="offerings" data-tone="kumkum" aria-labelledby="h-offer">
    <div class="wrap offer">
      <div class="offer__media">
        <video data-loop data-src={m('film/aarti.mp4')} poster={m('film/aarti-poster.jpg')} muted playsinline loop preload="none" aria-hidden="true"></video>
        <p class="small">Deeparadhana: camphor aarti at dusk</p>
      </div>
      <div class="offer__list">
        <h2 class="t-1" id="h-offer">Sevas</h2>
        <p class="lede">Message us on WhatsApp for any seva. We’ll confirm the date and tell you what to bring.</p>
        <ul class="acc">
          {offerings.map((o, i) => (
            <li class="acc__item">
              <h3>
                <button type="button" class="acc__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`of-${o.id}`} id={`ofb-${o.id}`}>
                  <span>{o.name}</span><Sc tag="small" kn={o.kn} te={o.te} /><i aria-hidden="true"></i>
                </button>
              </h3>
              <div class="acc__panel" id={`of-${o.id}`} role="region" aria-labelledby={`ofb-${o.id}`} hidden={i !== 0}>
                <p>{o.what}</p>
                <p class="small">{o.when}</p>
                <a class="btn" href={waMsg(o.message)} target="_blank" rel="noopener">{o.verb} {o.name} on WhatsApp</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Sharanam calls: one calls, everyone answers -->
  <section class="ch ch--vili" id="vili" data-tone="deep" aria-labelledby="h-vili">
    <div class="vili__bands" aria-hidden="true" data-bands>
      <p class="band band--call" data-band="-1"><span>{[...temple.vili, ...temple.vili].map((v) => `${v.en}  ·  `).join('')}</span></p>
      <p class="band band--answer sc" data-band="1"><span><span data-sc="kn">{Array(10).fill(`${temple.response.kn}  ·  `).join('')}</span><span data-sc="te">{Array(10).fill(`${temple.response.te}  ·  `).join('')}</span></span></p>
      <p class="band band--call band--sc sc" data-band="-0.7"><span><span data-sc="kn">{[...temple.vili, ...temple.vili].map((v) => `${v.kn}  ·  `).join('')}</span><span data-sc="te">{[...temple.vili, ...temple.vili].map((v) => `${v.te}  ·  `).join('')}</span></span></p>
    </div>
    <canvas class="vili__burst" data-burst aria-hidden="true"></canvas>
    <div class="wrap vili">
      <Sc tag="p" kn={terms.sharanuGhosha.kn} te={terms.sharanuGhosha.te} class="vili__eyebrow" />
      <h2 class="t-1" id="h-vili">One calls, everyone answers</h2>
      <p class="lede">Before padi pooja the temple fills with sharanu ghosha. A guruswamy calls out a name of Ayyappa, and every voice answers, Sharanam Ayyappa. Press Call to lead the next name, and the swamys will answer you.</p>
      <div class="vili__stage">
        <p class="vili__call" data-call-text aria-live="polite"><span lang="en">{temple.vili[0].en}</span><Sc kn={temple.vili[0].kn} te={temple.vili[0].te} class="vili__call-sc" /></p>
        <p class="vili__answer" data-answer-text aria-hidden="true">{temple.response.en}</p>
        <button type="button" class="vili__btn" data-call>
          <span class="vili__ring" aria-hidden="true"></span>
          <span class="vili__lbl">Call</span>
          <span class="vili__sub" data-call-next>{temple.vili[0].en}</span>
        </button>
        <p class="small vili__count" data-call-count aria-live="polite">Press to call. Sound turns on with your first call.</p>
      </div>
    </div>
  </section>

  <!-- Padi pooja: the climb to darshan -->
  <section class="ch ch--film ch--climb" id="climb" data-tone="deep" aria-labelledby="h-climb" style="--len:960svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/climb.mp4')} data-src-m={m('film/climb-m.mp4')} poster={m('film/steps-poster.jpg')} muted playsinline preload="auto" aria-label="Climbing the eighteen steps to the darshan of Lord Ayyappa"></video>
      <canvas class="embers" data-embers aria-hidden="true"></canvas>
      <div class="veil veil--climb"></div>
      <div class="wrap climb">
        <div class="climb__intro" data-climb-intro>
          <Sc tag="p" kn={terms.padi.kn} te={terms.padi.te} class="climb__eyebrow" />
          <h2 class="t-1" id="h-climb">Padi pooja</h2>
          <p class="lede">On padi pooja evenings, at the temple on Thursdays or at a swamy’s home, the eighteen steps are decorated and lit one by one, with bhajana. Each step stands for something the swamy leaves behind on the way up.</p>
        </div>
        <div class="climb__step" data-climb-step aria-live="polite">
          <p class="climb__n num"><span data-step-n>01</span><small>of 18</small></p>
          <p class="climb__name sc" data-step-name><span lang="kn" data-sc="kn">{stairs.kn.steps[0][0]}</span><span lang="te" data-sc="te">{stairs.te.steps[0][0]}</span></p>
          <p class="climb__sk" data-step-en><span data-sc="kn">{stairs.kn.steps[0][1]}</span><span data-sc="te">{stairs.te.steps[0][1]}</span></p>
          <p class="climb__grp small" data-step-grp><span data-sc="kn"><span lang="kn" class="sc">{stairs.kn.groups[0].sc}</span> · {stairs.kn.groups[0].en}</span><span data-sc="te"><span lang="te" class="sc">{stairs.te.groups[0].sc}</span> · {stairs.te.groups[0].en}</span></p>
        </div>
      </div>
      <ol class="rail" data-rail aria-hidden="true">
        {stairs.kn.steps.map(() => <li></li>)}
      </ol>
      <div class="wrap darshan" data-darshan>
        <div class="darshan__copy" data-darshan-copy>
          <Sc tag="p" kn={terms.sanctum.kn} te={terms.sanctum.te} class="darshan__sc" />
          <h2 class="t-1" id="h-darshan">Darshan</h2>
          <p class="lede">At the eighteenth step, the sanctum. Lord Ayyappa sits in yoga, knees bound by the yogapatta, his right hand raised to the devotee. Above the steps the words read <i>tat tvam asi</i>: you are that.</p>
        </div>
      </div>
      <p class="darshan__chorus t-hero sc" data-darshan-chorus aria-hidden="true">
        <span lang="kn" data-sc="kn">{temple.chant.kn}</span>
        <span lang="te" data-sc="te">{temple.chant.te}</span>
      </p>
    </div>
  </section>

  <!-- Visit -->
  <section class="ch ch--visit" id="visit" data-tone="night" aria-labelledby="h-visit">
    <div class="wrap visit">
      <div>
        <h2 class="t-1" id="h-visit" data-rise>Come for darshan</h2>
      </div>
      <dl class="visit__facts">
        <div data-rise><dt>Address</dt><dd>{temple.address.map((l) => <span>{l}</span>)}</dd></div>
        <div data-rise><dt>Open</dt><dd><span>All day during the season</span><span class="small">Washrooms, bathing and a place to sleep for swamys</span></dd></div>
        <div data-rise><dt>Contact</dt><dd><span>WhatsApp {temple.whatsappDisplay}</span><span class="small">Sevas, padi pooja, annadanam, group visits</span></dd></div>
      </dl>
      <div class="visit__cta" data-rise>
        <a class="btn" href={temple.mapUrl} target="_blank" rel="noopener">Directions in Google Maps</a>
        <a class="btn btn--ghost" href={`${base}visit/`}>Plan your visit</a>
      </div>
    </div>
  </section>

  <!-- Harivarasanam -->
  <section class="ch ch--film" id="hari" data-tone="night" aria-labelledby="h-hari" style="--len:260svh">
    <div class="stage">
      <video class="film" data-scrub data-src={m('film/finale.mp4')} data-src-m={m('film/finale-m.mp4')} poster={m('film/finale-poster.jpg')} muted playsinline preload="none" aria-hidden="true"></video>
      <div class="veil veil--bottom"></div>
      <div class="wrap stage__copy stage__copy--low">
        <h2 class="t-1" id="h-hari">Harivarasanam</h2>
        <p class="lede">Harivarasanam is sung at the end of the evening pooja. Every lamp in the courtyard keeps burning through the night.</p>
      </div>
    </div>
  </section>

  <footer class="end" data-tone="night">
    <div class="wrap end__in">
      <p class="end__chant t-hero sc"><span lang="kn" data-sc="kn">{temple.chant.kn}</span><span lang="te" data-sc="te">{temple.chant.te}</span><span class="sr-only">{temple.chant.en}</span></p>
      <div class="end__grid">
        <nav aria-label="Footer">
          <ul>
            <li><a href={`${base}poojas/`}>Poojas and timings</a></li>
            <li><a href={`${base}festivals/`}>Events and festivals</a></li>
