  .day__cols { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); margin-top: clamp(32px, 4vw, 56px); max-width: 1000px; }
  .collage { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(12px, 2vw, 28px); margin-top: clamp(64px, 9vw, 120px); align-items: start; }
  .ph { margin: 0; }
  .ph img { width: 100%; height: auto; object-fit: cover; background: var(--ash-2); }
  .ph figcaption { font-size: 14px; color: var(--sub); margin-top: 10px; }
  .ph--a { grid-column: 1 / span 4; }
  .ph--a img { aspect-ratio: 3 / 4; }
  .ph--b { grid-column: 6 / span 3; margin-top: 16vh; }
