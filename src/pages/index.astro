  .sched { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .sched__row { display: grid; grid-template-columns: 76px minmax(0, 1fr) minmax(0, 1.25fr); gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--rule); align-items: baseline; transition: background-color .4s, padding .4s var(--ease); }
  .sched__t { font-family: var(--display); font-size: 24px; color: var(--head); }
  .sched__n { font-size: 19px; font-weight: 500; color: var(--head); display: grid; }
