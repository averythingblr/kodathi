  /* today */
  .sandal { padding-block: clamp(96px, 11vw, 150px); }
  .today { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
