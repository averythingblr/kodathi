  .sched__d { font-size: 15px; color: var(--fg); }
  .sched__row--close .sched__t, .sched__row--close .sched__n { color: var(--sub); }
  .sched__row.is-past { opacity: .5; }
  .sched__row.is-now { background: rgba(255,250,240,.45); padding-inline: 14px; margin-inline: -14px; border-radius: 4px; }
  .sched__row.is-now .sched__t::after { content: 'Now'; display: block; font-family: var(--body); font-size: 12px; color: var(--acc); letter-spacing: .04em; }
  .sched__row.is-next .sched__t::after { content: 'Next'; display: block; font-family: var(--body); font-size: 12px; color: var(--acc); letter-spacing: .04em; }

  /* mandala */
  .ch--mandala { min-height: 100svh; display: grid; align-items: center; overflow: hidden; background: #0e0b08; }
  .mandala__film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .9; }
  .mandala { position: relative; padding-block: 140px 120px; color: #e4c9a0; display: grid; gap: 22px; justify-items: start; }
  .mandala h2 { color: #f1e6d6; }
  .vratham { margin-top: 12px; display: grid; gap: 12px; }
  .vratham__beads { display: grid; grid-template-columns: repeat(21, 12px); gap: 7px; }
  .vratham__beads i { width: 12px; height: 12px; border-radius: 50%; background: rgba(228,201,160,.18); box-shadow: inset 0 -2px 0 rgba(0,0,0,.25); }
  .vratham__beads i.on { background: radial-gradient(circle at 35% 30%, #f3d38b, #b98a3e 60%, #6e4d1c); }
