  /* reduced motion: no pinning or scrubbing, posters stand in for film */
  :global(.rm) .ch--film { height: auto; }
  :global(.rm) .stage { position: relative; height: auto; min-height: 100svh; }
  :global(.rm) .climb__step { opacity: 1; transform: none; }
  :global(.rm) .real__frame { clip-path: none; }
  :global(.rm) .embers, :global(.rm) .summit, :global(.rm) .flood { display: none; }
</style>

