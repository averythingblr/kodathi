---
import Simple from '../../../layouts/Simple.astro';
import Sc from '../../../components/Sc.astro';
import { terms, kanneBrings, askGuru, wa } from '../../../data/site';
import { address, kanneAsk, mandala, stairs, stairGroup } from '../../../data/temple';
const DAYS = mandala.days;
---
<Simple page="maala" title="Maala Dharana" description="Maala dharana at the Ayyappa Swamy Temple, Kodathi: count your 41 days, what a kanne swamy brings, and what to call someone wearing the mala.">
  <header class="s-ph s-wrap">
    <Sc tag="p" kn={terms.mala.kn} te={terms.mala.te} />
    <h1>Maala Dharana</h1>
    <p class="s-lede">Maala dharana is going on since Monday 9 November 2026. Take the mala from a guruswamy; your 41 days begin on that day.</p>
    <div class="s-btns"><a class="s-btn" href={askGuru} target="_blank" rel="noopener">Speak to a guruswamy</a></div>
  </header>

  <section class="s-sec" aria-labelledby="h-count">
    <div class="s-wrap">
      <h2 class="s-h" id="h-count">Count your 41 days</h2>
      <div class="s-card" data-deeksha data-days={DAYS}>
        <label for="s-mala-date">The day you took the mala</label>
        <input id="s-mala-date" type="date" data-mala-date min="2026-09-01" />
        <div class="s-ring">
          <svg viewBox="0 0 200 200" aria-hidden="true" data-beads>
            {Array.from({ length: DAYS }, (_, i) => {
              const a = (i / DAYS) * Math.PI * 2 - Math.PI / 2;
              return <rect x={100 + 86 * Math.cos(a) - 4.5} y={100 + 86 * Math.sin(a) - 4.5} width="9" height="9" rx="3" />;
            })}
          </svg>
          <p data-mala-txt aria-live="polite"><b>Your 41 days</b><span>Choose the day you took the mala.</span></p>
        </div>
        <p class="s-note">Each swamy follows their own start date. It is kept only on your phone.</p>
      </div>
    </div>
  </section>

  <section class="s-sec s-sec--mist" aria-labelledby="h-kanne">
    <div class="s-wrap">
      <h2 class="s-h" id="h-kanne">Taking the mala for the first time?</h2>
      <p class="s-lede">What a kanne swamy brings <Sc kn={terms.kanne.kn} te={terms.kanne.te} /></p>
      <ul class="s-kanne">{kanneBrings.map(([h, p]) => <li><b>{h}</b><span>{p}</span></li>)}</ul>
      <p class="s-note">Not sure where to get these?</p>
      <div class="s-btns"><a class="s-btn s-btn--line" href={wa(kanneAsk)} target="_blank" rel="noopener">Ask the temple on WhatsApp</a></div>
    </div>
  </section>

  <section class="s-sec" aria-labelledby="h-call">
    <div class="s-wrap">
      <h2 class="s-h" id="h-call">What to call someone wearing the mala</h2>
      <p class="s-lede">Greet them, and say goodbye, with <i>Swamiye Sharanam</i>.</p>
      <ul class="s-address">
        {address.map((a) => <li><small>{a.who}</small><b>{a.en}</b><Sc kn={a.kn} te={a.te} /></li>)}
      </ul>
    </div>
  </section>

  <section class="s-sec s-sec--mist" aria-labelledby="h-steps">
    <div class="s-wrap">
      <h2 class="s-h" id="h-steps">The eighteen steps <Sc kn={terms.steps.kn} te={terms.steps.te} /></h2>
      <div class="s-steps" data-steps>
        <svg viewBox="0 0 320 200" aria-hidden="true">
          {Array.from({ length: 18 }, (_, i) => { const w = 220 - i * 8; return <rect class="s-stair" data-stair={i} x={160 - w / 2} y={186 - i * 10} width={w} height="8" rx="1" />; })}
        </svg>
        <p class="s-step__n">Step <span class="num" data-step-n>1</span> of 18</p>
        {(['kn', 'te'] as const).map((lang) => (
          <ol class="s-step" data-sc={lang} lang={lang}>
            {stairs[lang].steps.map(([sc, en], i) => <li data-step={i} hidden={i !== 0}><b>{sc}</b><span lang="en">{en}</span><small lang="en">{stairGroup(lang, i).en}</small></li>)}
          </ol>
        ))}
        <div class="s-btns">
          <button class="s-btn s-btn--line" type="button" data-step-prev>Back</button>
          <button class="s-btn" type="button" data-step-next>Next step</button>
        </div>
      </div>
    </div>
  </section>
</Simple>
