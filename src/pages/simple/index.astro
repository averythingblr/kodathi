---
import Simple from '../../layouts/Simple.astro';
import Sc from '../../components/Sc.astro';
import SEvents from '../../components/SEvents.astro';
import { temple, terms, about, albums, morning, evening, time, m, cover, longDate, chief, stepsPhoto, templeAlbum } from '../../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = `${base}simple/`;
const kanne = albums.find((a) => a.kind === 'kanne')!;
const padiPhoto = templeAlbum.items.filter((i) => i.type === 'photo')[1] ?? stepsPhoto;
---
<Simple page="home">
  <section class="s-welcome">
    <div class="s-wrap">
      <Sc tag="p" kn={temple.chant.kn} te={temple.chant.te} />
      <h1>{temple.name}, {temple.place}</h1>
      <p class="s-welcome__road">{temple.address[0]}, Bengaluru</p>
      <p class="s-lede">A quiet place for prayer, among trees and beside the lake. Swamys come here from Kodathi, Mullur, Sarjapura Road and the places around.</p>
      <div class="s-btns">
        <a class="s-btn" href={temple.mapUrl} target="_blank" rel="noopener">Get directions</a>
        <a class="s-btn s-btn--line" href={`${home}poojas/`}>Pooja timings</a>
      </div>
    </div>
    <figure class="s-hero-ph s-wrap">
      <img src={m(stepsPhoto.src)} alt={stepsPhoto.alt} width={stepsPhoto.w} height={stepsPhoto.h} fetchpriority="high" />
      <figcaption>Padi pooja at the temple, {longDate(templeAlbum.date)}</figcaption>
    </figure>
  </section>

  <section class="s-sec s-sec--mist" aria-labelledby="h-today">
    <div class="s-wrap">
      <h2 class="s-h" id="h-today">Poojas every day</h2>
      <ul class="s-times">
        {[morning, evening].map((p) => <li><b class="num">{time(p.at)}</b><span>{p.name} <Sc kn={p.kn} te={p.te} /></span></li>)}
      </ul>
      <p class="s-note">The temple is open all day during the season.</p>
    </div>
  </section>

  <section class="s-sec" aria-labelledby="h-coming">
    <div class="s-wrap">
      <h2 class="s-h" id="h-coming">Coming up</h2>
      <SEvents max={3} />
      <div class="s-btns"><a class="s-btn s-btn--line" href={`${home}events/`}>All events</a></div>
    </div>
  </section>

  <section class="s-sec s-sec--mist" aria-labelledby="h-offer">
    <div class="s-wrap">
      <h2 class="s-h" id="h-offer">At our temple</h2>
      <ul class="s-circles">
        <li>
          <img src={m(padiPhoto.thumb)} alt={padiPhoto.alt} width="600" height="800" loading="lazy" />
          <h3>Padi pooja</h3>
          <Sc tag="p" kn={terms.padi.kn} te={terms.padi.te} />
          <p>On Thursday evenings at the temple, and at homes on request, when someone offers it.</p>
          <a class="s-link" href={`${home}poojas/#padi-pooja`}>Offer padi pooja</a>
        </li>
        <li>
          <img src={m(kanne.items[0].thumb)} alt={kanne.items[0].alt} width="600" height="800" loading="lazy" />
          <h3>Maala dharana</h3>
          <Sc tag="p" kn={terms.mala.kn} te={terms.mala.te} />
          <p>Going on since Monday 9 November 2026. Your 41 days begin on the day you take the mala.</p>
          <a class="s-link" href={`${home}maala-dharana/`}>Taking the mala</a>
        </li>
        <li>
          <img src={m(`swamis/${chief.photo}`)} alt={chief.name} width="800" height="1000" loading="lazy" />
          <h3>Our Guruswamys</h3>
          <Sc tag="p" kn={terms.guruswamy.kn} te={terms.guruswamy.te} />
          <p>{chief.name}, our Chief Guruswamy, has worn the mala since {chief.since}.</p>
          <a class="s-link" href={`${home}swamis/`}>Meet our guruswamys and swamys</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="s-sec" aria-labelledby="h-about">
    <div class="s-wrap">
      <h2 class="s-h" id="h-about">Our temple</h2>
      <div class="s-prose"><p>{about.place}</p><p>{about.worship}</p></div>
      <div class="s-btns"><a class="s-btn s-btn--line" href={`${home}temple/`}>About the temple</a></div>
    </div>
  </section>

  <section class="s-sec s-sec--mist" aria-labelledby="h-photos">
    <div class="s-wrap">
      <h2 class="s-h" id="h-photos">From our poojas</h2>
      <ul class="s-albums">
        {albums.slice(0, 3).map((a) => (
          <li><a href={`${home}gallery/#${a.id}`}><img src={m(cover(a))} alt="" width="540" height="960" loading="lazy" /><b>{a.title}</b><span>{longDate(a.date)}</span></a></li>
        ))}
      </ul>
      <div class="s-btns"><a class="s-btn" href={`${home}gallery/`}>View gallery</a></div>
    </div>
  </section>
</Simple>
