---
// Mockup 1, Karuppu: the black cloth a swamy wears, kumkum and turmeric, and the chant in big rounded script.
import '@fontsource/baloo-tamma-2/600.css';
import '@fontsource/baloo-tamma-2/800.css';
import '@fontsource/baloo-tammudu-2/600.css';
import '@fontsource/baloo-tammudu-2/800.css';
import '@fontsource/hind/400.css';
import '@fontsource/hind/600.css';
import Mock from '../../../layouts/Mock.astro';
import { temple, terms, about, offerings, dated, clock, morning, evening, time, chief, guru, longServing, since, sm, m, wa, askGuru, albums, cover, longDate, weekday, dayNum, monShort } from '../_data';
---
<Mock n={1} name="Karuppu" theme="#14141b">
  <main class="k">
    <header class="k-top">
      <p class="k-top__name">{temple.name}<span>{temple.place}, Bengaluru</span></p>
      <a class="k-pill" href={temple.mapUrl} target="_blank" rel="noopener">Directions</a>
    </header>

    <section class="k-hero">
      <p class="k-chant" aria-label={temple.chant.en}>
        <span data-sc="kn" lang="kn">{temple.chant.kn}</span><span data-sc="te" lang="te">{temple.chant.te}</span>
      </p>
      <div class="k-tilak" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
      <h1>Ayyappa Swamy Temple, Kodathi</h1>
      <p class="k-road">{temple.address[0]}, Bengaluru. Among trees, beside the lake.</p>
      <div class="k-times">
        <p><b>{time(morning.at)}</b><span>{morning.name}</span></p>
        <p><b>{time(evening.at)}</b><span>{evening.name}</span></p>
      </div>
      <p class="k-open">Open all day during the season</p>
    </section>

    <section class="k-next" aria-labelledby="k-next-h">
      <h2 id="k-next-h">Coming up</h2>
      <ol data-events="2">
        {dated.map((e) => (
          <li data-date={e.start}>
            <p class="k-date"><b>{dayNum(e.start)}</b>{monShort(e.start)}</p>
            <div>
              <p class="k-left" data-left></p>
              <h3>{e.name}</h3>
              <p>{weekday(e.start)}{e.time ? `, ${clock(e.time)}` : ''}</p>
              {e.map && <a href={e.map} target="_blank" rel="noopener">Directions</a>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="k-mala" aria-labelledby="k-mala-h">
      <p class="k-sc"><span data-sc="kn" lang="kn">{terms.mala.kn}</span><span data-sc="te" lang="te">{terms.mala.te}</span></p>
      <h2 id="k-mala-h">Taking the mala?</h2>
      <p>Maala dharana is going on since Monday 9 November 2026. Your 41 days begin on the day you take the mala from a guruswamy.</p>
      <a class="k-btn" href={askGuru} target="_blank" rel="noopener">Speak to a guruswamy on WhatsApp</a>
    </section>

    <section class="k-guru" aria-labelledby="k-guru-h">
      <h2 id="k-guru-h">Our Guruswamys and Swamys</h2>
      <ul>
        {[chief, guru, ...longServing].map((s, i) => (
          <li class={i < 2 ? 'is-guru' : ''}>
            <img src={m(`swamis/${sm(s.photo)}`)} alt={s.name} width="320" height="320" loading="lazy" />
            <b>{s.name}</b>
            {i < 2 && <span class="k-role">{i === 0 ? 'Chief Guruswamy' : 'Guruswamy'}</span>}<span>{since(s)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="k-sevas" aria-labelledby="k-sevas-h">
      <h2 id="k-sevas-h">Sevas</h2>
      <ul>
        {offerings.map((o) => (
          <li><a href={wa(o.message)} target="_blank" rel="noopener"><b>{o.name}</b><span data-sc="kn" lang="kn">{o.kn}</span><span data-sc="te" lang="te">{o.te}</span><small>{o.verb} on WhatsApp</small></a></li>
        ))}
      </ul>
    </section>

    <section class="k-photos" aria-labelledby="k-photos-h">
      <h2 id="k-photos-h">From our poojas</h2>
      <ul>
        {albums.map((a) => (
          <li><a href={`/gallery/#album-${a.id}`}><img src={m(cover(a))} alt="" width="540" height="960" loading="lazy" /><b>{a.title}</b><span>{longDate(a.date)}</span></a></li>
        ))}
      </ul>
    </section>

    <footer class="k-visit">
      <h2>Visit</h2>
      <p>{temple.address.join(', ')}</p>
      <p>{about.has.slice(3).map(([h]) => h).join(', ')}.</p>
      <a class="k-btn" href={temple.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
      <a class="k-pill" href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a>
    </footer>
  </main>

  <style is:global>
    .k {
      --cloth: #15151d; --cloth-2: #1d1d28; --kumkum: #c8102e; --turmeric: #f2b705; --ash: #e9e6df; --sandal: #e7c9a0;
      background-color: var(--cloth);
      /* the weave of a black mundu: two fine crossing threads */
      background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 3px), repeating-linear-gradient(90deg, rgb(255 255 255 / 0.014) 0 1px, transparent 1px 4px);
      color: var(--ash); font: 400 1.0625rem/1.6 'Hind', system-ui, sans-serif; padding-bottom: 96px;
    }
    .k h1, .k h2, .k h3, .k-chant, .k b { font-family: 'Baloo Tamma 2', 'Baloo Tammudu 2', system-ui, sans-serif; }
    :root[data-script='te'] .k h1, :root[data-script='te'] .k h2, :root[data-script='te'] .k-chant { font-family: 'Baloo Tammudu 2', 'Baloo Tamma 2', system-ui, sans-serif; }
    .k > * { padding-inline: max(16px, env(safe-area-inset-left)) max(16px, env(safe-area-inset-right)); max-width: 760px; margin-inline: auto; }
    .k h2 { font-size: clamp(1.75rem, 1.2rem + 3vw, 2.6rem); line-height: 1.1; font-weight: 800; margin: 0 0 16px; color: var(--ash); text-wrap: balance; }
    .k p { margin: 0; }
    .k a { color: inherit; }
    .k-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; }
    .k-top__name { display: grid; font-weight: 600; line-height: 1.2; }
    .k-top__name span { font-weight: 400; font-size: 0.875rem; color: var(--sandal); }
    .k-pill { display: inline-grid; place-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 2px solid var(--turmeric); color: var(--turmeric) !important; text-decoration: none; font-weight: 600; }
    .k-btn { display: inline-grid; place-items: center; min-height: 52px; padding: 0 22px; border-radius: 14px; background: var(--turmeric); color: #1a1407 !important; text-decoration: none; font-weight: 600; }
    .k-hero { padding-block: 28px 40px; }
    .k-chant { font-size: clamp(3rem, 1.6rem + 9vw, 6.5rem); line-height: 1.12; font-weight: 800; color: var(--turmeric); margin: 0; text-wrap: balance; }
    .k-tilak { position: relative; display: grid; gap: 7px; width: 132px; margin: 22px 0 26px; }
    .k-tilak i { display: block; height: 5px; border-radius: 3px; background: var(--ash); opacity: 0.85; }
    .k-tilak b { position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: var(--kumkum); }
    .k-hero h1 { font-size: clamp(1.9rem, 1.3rem + 3.4vw, 3rem); line-height: 1.08; font-weight: 800; margin: 0; }
    .k-road { margin-top: 10px; color: var(--sandal); }
    .k-times { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 28px; }
    .k-times p { display: grid; padding: 16px; border-radius: 18px; background: var(--cloth-2); border: 1px solid rgb(233 230 223 / 0.12); }
    .k-times b { font-size: clamp(2rem, 1.4rem + 3vw, 2.8rem); line-height: 1; color: var(--ash); font-weight: 800; }
    .k-times span { color: var(--sandal); margin-top: 6px; }
    .k-open { margin-top: 14px !important; color: var(--sandal); }
    .k-next { padding-block: 8px 40px; }
    .k-next ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .k-next li { display: grid; grid-template-columns: 76px 1fr; gap: 16px; align-items: start; padding: 18px; border-radius: 18px; background: var(--cloth-2); }
    .k-next li[hidden] { display: none; }
    .k-next li.is-soon { background: var(--kumkum); color: #fff; }
    .k-date { display: grid; justify-items: center; padding: 8px 0; border-radius: 12px; background: rgb(0 0 0 / 0.25); font-size: 0.9375rem; }
    .k-date b { font-size: 2.2rem; line-height: 1; }
    .k-left { font-weight: 600; color: var(--turmeric); }
    .is-soon .k-left { color: #fff; }
    .k-next h3 { font-size: 1.375rem; line-height: 1.2; margin: 2px 0; font-weight: 800; }
    .k-next a { display: inline-grid; align-items: center; min-height: 44px; font-weight: 600; }
    .k-mala { padding-block: 40px; border-top: 6px solid var(--kumkum); background: linear-gradient(var(--cloth-2), var(--cloth)); }
    .k-sc { font-size: 1.25rem; color: var(--turmeric); margin-bottom: 4px !important; font-family: 'Baloo Tamma 2', 'Baloo Tammudu 2'; }
    .k-mala p:not(.k-sc) { margin-bottom: 20px; max-width: 60ch; }
    .k-guru { padding-block: 40px; }
    .k-guru ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 14px; }
    .k-guru li { display: grid; justify-items: center; text-align: center; gap: 2px; }
    .k-guru img { width: 100%; max-width: 150px; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 4px solid var(--cloth-2); margin-bottom: 8px; }
    .k-guru .is-guru img { border-color: var(--turmeric); }
    .k-guru b { font-size: 1.2rem; line-height: 1.2; }
    .k-guru span { font-size: 0.9375rem; color: var(--sandal); line-height: 1.35; }
    .k-guru .k-role { color: var(--turmeric); font-weight: 600; }
    .k-sevas { padding-block: 40px; }
    .k-sevas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .k-sevas a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0 12px; min-height: 64px; padding: 12px 18px; border-radius: 16px; background: var(--cloth-2); text-decoration: none; }
    .k-sevas b { font-size: 1.375rem; font-weight: 800; }
    .k-sevas [data-sc] { grid-column: 2; grid-row: 1; color: var(--turmeric); font-family: 'Baloo Tamma 2', 'Baloo Tammudu 2'; font-size: 1.125rem; }
    .k-sevas small { grid-column: 1 / -1; color: var(--sandal); font-size: 0.9375rem; }
    .k-photos { padding-block: 40px; }
    .k-photos ul { list-style: none; margin: 0; padding: 0 0 6px; display: grid; grid-auto-flow: column; grid-auto-columns: 62%; gap: 12px; overflow-x: auto; scroll-snap-type: inline proximity; }
    .k-photos li { scroll-snap-align: start; }
    .k-photos a { display: grid; gap: 4px; text-decoration: none; }
    .k-photos img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 18px; }
    .k-photos b { font-size: 1.125rem; line-height: 1.25; margin-top: 6px; }
    .k-photos span { color: var(--sandal); font-size: 0.875rem; }
    .k-visit { padding-block: 40px; display: grid; gap: 12px; justify-items: start; border-top: 1px solid rgb(233 230 223 / 0.14); }
    .k-visit p { color: var(--sandal); }
    @media (min-width: 760px) { .k-guru ul { grid-template-columns: repeat(4, 1fr); } .k-photos ul { grid-auto-columns: 32%; } }
  </style>
</Mock>
