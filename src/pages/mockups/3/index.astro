---
// Mockup 3, Calendar: the printed temple calendar on every South Indian wall. Today's sheet first, big and red.
import '@fontsource/rozha-one/400.css';
import '@fontsource/noto-sans-kannada/500.css';
import '@fontsource/noto-sans-telugu/500.css';
import '@fontsource/hind/400.css';
import '@fontsource/hind/600.css';
import Mock from '../../../layouts/Mock.astro';
import { temple, terms, offerings, dated, clock, morning, evening, time, chief, guru, longServing, since, sm, m, wa, askGuru, albums, cover, dayNum, monShort, weekday } from '../_data';
---
<Mock n={3} name="Calendar" theme="#c1121f">
  <main class="c">
    <header class="c-mast">
      <p class="c-sc"><span data-sc="kn" lang="kn">{temple.chant.kn}</span><span data-sc="te" lang="te">{temple.chant.te}</span></p>
      <h1>Ayyappa Swamy Temple</h1>
      <p>Kodathi, {temple.address[0]}, Bengaluru</p>
    </header>

    <section class="c-sheet" aria-labelledby="c-today-h">
      <div class="c-sheet__date" data-today>
        <p data-t="wd">Today</p>
        <p class="c-big" data-t="d">–</p>
        <p data-t="m"></p>
      </div>
      <div class="c-sheet__body">
        <h2 id="c-today-h">At the temple today</h2>
        <ul>
          <li><b>{time(morning.at)}</b> {morning.name}</li>
          <li><b>{time(evening.at)}</b> {evening.name}</li>
        </ul>
        <ol data-events="1" class="c-today-ev">
          {dated.map((e) => <li data-date={e.start}><span data-left></span>: {e.name}{e.time ? `, ${clock(e.time)}` : ''}{e.map && <a href={e.map} target="_blank" rel="noopener">Directions</a>}</li>)}
        </ol>
        <p class="c-open">The temple is open all day during the season.</p>
      </div>
    </section>

    <section class="c-box" aria-labelledby="c-dates-h">
      <h2 id="c-dates-h">Dates to keep</h2>
      <ol class="c-tiles" data-events="6">
        {dated.map((e) => (
          <li data-date={e.start}>
            <p class="c-tile__d"><b>{dayNum(e.start)}</b><span>{monShort(e.start)}</span></p>
            <p class="c-tile__t"><b>{e.name}</b><span>{weekday(e.start)}{e.time ? `, ${clock(e.time)}` : ''}</span></p>
          </li>
        ))}
      </ol>
      <a class="c-link" href="/festivals/">All events, with Add to calendar</a>
    </section>

    <section class="c-box c-box--green" aria-labelledby="c-mala-h">
      <p class="c-sc"><span data-sc="kn" lang="kn">{terms.mala.kn}</span><span data-sc="te" lang="te">{terms.mala.te}</span></p>
      <h2 id="c-mala-h">Maala dharana</h2>
      <p>Going on since Monday 9 November 2026. Your 41 days begin on the day you take the mala from a guruswamy.</p>
      <a class="c-btn" href={askGuru} target="_blank" rel="noopener">Speak to a guruswamy on WhatsApp</a>
    </section>

    <section class="c-box" aria-labelledby="c-guru-h">
      <h2 id="c-guru-h">Our Guruswamys and Swamys</h2>
      <ul class="c-guru">
        {[chief, guru, ...longServing].map((s, i) => (
          <li><img src={m(`swamis/${sm(s.photo)}`)} alt={s.name} width="320" height="320" loading="lazy" /><b>{s.name}</b><span>{i === 0 ? 'Chief Guruswamy' : i === 1 ? 'Guruswamy' : since(s)}</span></li>
        ))}
      </ul>
    </section>

    <section class="c-box" aria-labelledby="c-seva-h">
      <h2 id="c-seva-h">Sevas</h2>
      <ul class="c-sevas">
        {offerings.map((o) => <li><a href={wa(o.message)} target="_blank" rel="noopener"><b>{o.name}</b><span>{o.when}</span></a></li>)}
      </ul>
      <p class="c-note">Each one opens WhatsApp with a message ready to send.</p>
    </section>

    <section class="c-box" aria-labelledby="c-ph-h">
      <h2 id="c-ph-h">Photos</h2>
      <ul class="c-photos">
        {albums.map((a) => <li><a href={`/gallery/#album-${a.id}`}><img src={m(cover(a))} alt="" width="540" height="960" loading="lazy" /><span>{a.title}</span></a></li>)}
      </ul>
    </section>

    <footer class="c-foot">
      <p>{temple.address.join(', ')}</p>
      <a class="c-btn" href={temple.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
      <a class="c-link" href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a>
    </footer>
  </main>
  <script is:inline>
    (function () {
      var o = { timeZone: 'Asia/Kolkata' }, n = new Date();
      var set = function (k, v) { var e = document.querySelector('[data-today] [data-t="' + k + '"]'); if (e) e.textContent = v; };
      set('wd', new Intl.DateTimeFormat('en-GB', Object.assign({ weekday: 'long' }, o)).format(n));
      set('d', new Intl.DateTimeFormat('en-GB', Object.assign({ day: 'numeric' }, o)).format(n));
      set('m', new Intl.DateTimeFormat('en-GB', Object.assign({ month: 'long', year: 'numeric' }, o)).format(n));
    })();
  </script>

  <style is:global>
    .c { --red: #c1121f; --red-d: #8f0d17; --marigold: #f6c744; --paper: #fff8e1; --green: #0b6e4f; --ink: #231a10;
      background: var(--marigold); color: var(--ink); font: 400 1.0625rem/1.6 'Hind', system-ui, sans-serif; padding: 0 0 96px; }
    .c h1, .c h2, .c-big, .c-tile__d b { font-family: 'Rozha One', Georgia, serif; font-weight: 400; }
    .c p { margin: 0; }
    .c a { color: inherit; }
    .c-sc { font-family: 'Noto Sans Kannada', 'Noto Sans Telugu', sans-serif; font-weight: 500; }
    .c > * { margin-inline: max(12px, env(safe-area-inset-left)) max(12px, env(safe-area-inset-right)); }
    .c-mast { margin: 0; padding: 22px 16px 26px; background: var(--red); color: var(--paper); text-align: center; border-bottom: 6px double var(--marigold); }
    .c-mast .c-sc { color: var(--marigold); font-size: 1.125rem; }
    .c-mast h1 { font-size: clamp(2.3rem, 1.5rem + 5vw, 4.2rem); line-height: 1; margin: 6px 0 8px; }
    /* today's tear-off sheet */
    .c-sheet { margin-top: -10px; position: relative; display: grid; grid-template-columns: 112px 1fr; background: var(--paper); border: 3px solid var(--red); box-shadow: 0 3px 0 var(--red-d); }
    .c-sheet::before { content: ''; position: absolute; inset: -10px 18px auto; height: 10px; background: radial-gradient(circle at 8px 5px, var(--ink) 3px, transparent 3.5px) 0 0 / 22px 10px repeat-x; }
    .c-sheet__date { display: grid; align-content: start; justify-items: center; padding: 14px 6px; background: var(--red); color: var(--paper); text-align: center; font-size: 0.9375rem; line-height: 1.3; }
    .c-big { font-size: 4.6rem; line-height: 1; margin: 4px 0 !important; }
    .c-sheet__body { padding: 14px 16px 16px; }
    .c-sheet__body h2 { font-size: 1.6rem; line-height: 1.1; margin: 0 0 8px; color: var(--red); }
    .c-sheet__body ul, .c-today-ev { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .c-sheet__body b { font-weight: 600; color: var(--red); }
    .c-today-ev { margin-top: 10px; }
    .c-today-ev li { padding: 8px 10px; background: var(--marigold); font-weight: 600; }
    .c-today-ev li[hidden] { display: none; }
    .c-today-ev a { display: inline-grid; align-items: center; min-height: 44px; margin-left: 8px; font-weight: 400; }
    .c-open { margin-top: 10px !important; font-size: 0.9375rem; }
    /* framed boxes like the panels of a printed calendar */
    .c-box { margin-top: 18px; padding: 20px 16px; background: var(--paper); border: 3px double var(--red); outline: 6px solid var(--paper); outline-offset: -12px; }
    .c-box h2 { font-size: clamp(1.8rem, 1.4rem + 2vw, 2.4rem); line-height: 1.05; margin: 0 0 14px; color: var(--red); }
    .c-box--green { background: var(--green); color: #fff; border-color: var(--marigold); outline-color: var(--green); }
    .c-box--green h2, .c-box--green .c-sc { color: var(--marigold); }
    .c-box--green p { margin-bottom: 16px; }
    .c-tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .c-tiles li { display: grid; grid-template-columns: 74px 1fr; border: 2px solid var(--ink); }
    .c-tiles li[hidden] { display: none; }
    .c-tiles li.is-soon { border-color: var(--red); background: #ffe9a6; }
    .c-tile__d { display: grid; justify-items: center; align-content: center; padding: 6px; background: var(--ink); color: var(--paper); line-height: 1.1; }
    .is-soon .c-tile__d { background: var(--red); }
    .c-tile__d b { font-size: 2rem; }
    .c-tile__d span { font-size: 0.875rem; }
    .c-tile__t { display: grid; padding: 8px 12px; line-height: 1.3; }
    .c-tile__t b { font-weight: 600; }
    .c-tile__t span { font-size: 0.9375rem; }
    .c-link { display: inline-grid; align-items: center; min-height: 44px; margin-top: 8px; font-weight: 600; text-underline-offset: 5px; text-decoration-color: var(--red); }
    .c-btn { display: inline-grid; place-items: center; min-height: 52px; padding: 0 20px; background: var(--red); color: #fff !important; font-weight: 600; text-decoration: none; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
    .c-box--green .c-btn { background: var(--marigold); color: var(--ink) !important; }
    .c-guru { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 12px; text-align: center; }
    .c-guru li { display: grid; justify-items: center; }
    .c-guru img { width: 116px; height: 116px; border-radius: 50%; object-fit: cover; border: 4px solid var(--marigold); outline: 2px solid var(--red); margin-bottom: 8px; }
    .c-guru b { font-weight: 600; line-height: 1.25; }
    .c-guru span { font-size: 0.875rem; }
    .c-sevas { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .c-sevas a { display: grid; min-height: 56px; padding: 8px 12px; text-decoration: none; border-left: 6px solid var(--red); background: #fff1c7; }
    .c-sevas b { font-family: 'Rozha One', serif; font-weight: 400; font-size: 1.375rem; line-height: 1.2; }
    .c-sevas span { font-size: 0.9375rem; }
    .c-note { margin-top: 10px !important; font-size: 0.9375rem; }
    .c-photos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .c-photos a { display: grid; gap: 4px; text-decoration: none; font-size: 0.8125rem; line-height: 1.3; }
    .c-photos img { aspect-ratio: 3 / 4; object-fit: cover; border: 2px solid var(--ink); }
    .c-foot { margin-top: 18px; padding: 20px 16px; display: grid; gap: 12px; justify-items: start; background: var(--red); color: var(--paper); border: 3px double var(--marigold); }
    .c-foot .c-btn { background: var(--marigold); color: var(--ink) !important; }
    @media (min-width: 760px) { .c > * { max-width: 760px; margin-inline: auto; } .c-mast { max-width: none; } .c-guru { grid-template-columns: repeat(4, 1fr); } }
  </style>
</Mock>
