---
// Mockup 5, Deepam: the temple's own lamp-lit photographs carry the page. Words stay few and quiet around them.
import '@fontsource/tiro-kannada/400.css';
import '@fontsource/tiro-kannada/400-italic.css';
import '@fontsource/tiro-telugu/400.css';
import '@fontsource/hind/400.css';
import '@fontsource/hind/600.css';
import Mock from '../../../layouts/Mock.astro';
import { temple, terms, offerings, dated, clock, morning, evening, time, chief, guru, longServing, since, sm, m, wa, askGuru, albums, stepsPhoto, longDate, weekday } from '../_data';
const strip = albums.flatMap((a) => a.items.map((i) => ({ ...i, album: a.title, date: a.date }))).slice(0, 10);
---
<Mock n={5} name="Deepam" theme="#120c08">
  <main class="d">
    <section class="d-hero">
      <img src={m(stepsPhoto.src)} alt={stepsPhoto.alt} width={stepsPhoto.w} height={stepsPhoto.h} fetchpriority="high" />
      <div class="d-hero__txt">
        <p class="d-sc"><span data-sc="kn" lang="kn">{temple.chant.kn}</span><span data-sc="te" lang="te">{temple.chant.te}</span></p>
        <h1>Ayyappa Swamy Temple, Kodathi</h1>
        <p>{temple.address[0]}, Bengaluru</p>
        <a class="d-btn" href={temple.mapUrl} target="_blank" rel="noopener">Directions</a>
      </div>
    </section>

    <section class="d-tonight" aria-labelledby="d-t-h">
      <h2 id="d-t-h">Poojas every day</h2>
      <p class="d-times"><span><b>{time(morning.at)}</b> {morning.name}</span><span><b>{time(evening.at)}</b> {evening.name}</span></p>
      <ol data-events="2">
        {dated.map((e) => <li data-date={e.start}><i data-left></i><b>{e.name}</b><span>{weekday(e.start)}{e.time ? `, ${clock(e.time)}` : ''}</span>{e.map && <a href={e.map} target="_blank" rel="noopener">Directions</a>}</li>)}
      </ol>
    </section>

    <section class="d-strip" aria-labelledby="d-s-h">
      <h2 id="d-s-h">From our poojas</h2>
      <ul>
        {strip.map((it) => <li><a href="/gallery/"><img src={m(it.thumb)} alt={it.alt} width={it.w} height={it.h} loading="lazy" /></a></li>)}
      </ul>
      <p>{albums.map((a) => `${a.title}, ${longDate(a.date)}`).join('. ')}.</p>
      <a class="d-link" href="/gallery/">All photos and videos</a>
    </section>

    <section class="d-quiet" aria-labelledby="d-m-h">
      <p class="d-sc"><span data-sc="kn" lang="kn">{terms.mala.kn}</span><span data-sc="te" lang="te">{terms.mala.te}</span></p>
      <h2 id="d-m-h">Maala dharana is going on</h2>
      <p>Since Monday 9 November 2026. Your 41 days begin on the day you take the mala from a guruswamy.</p>
      <a class="d-btn" href={askGuru} target="_blank" rel="noopener">Speak to a guruswamy</a>
    </section>

    <section class="d-people" aria-labelledby="d-g-h">
      <h2 id="d-g-h">Our guruswamys</h2>
      {[chief, guru].map((s, i) => (
        <figure>
          <img src={m(`swamis/${s.photo}`)} alt={s.name} width="800" height="1000" loading="lazy" />
          <figcaption><b>{s.name}</b><span>{i ? 'Guruswamy' : 'Chief Guruswamy'}. {since(s)}.</span></figcaption>
        </figure>
      ))}
      <ul>
        {longServing.map((s) => <li><img src={m(`swamis/${sm(s.photo)}`)} alt={s.name} width="320" height="320" loading="lazy" /><b>{s.name}</b><span>{since(s)}</span></li>)}
      </ul>
    </section>

    <section class="d-quiet" aria-labelledby="d-sv-h">
      <h2 id="d-sv-h">Offer a seva</h2>
      <ul class="d-sevas">
        {offerings.map((o) => <li><a href={wa(o.message)} target="_blank" rel="noopener"><b>{o.name}</b><span>{o.when}</span></a></li>)}
      </ul>
    </section>

    <footer class="d-quiet d-foot">
      <h2>Come for darshan</h2>
      <p>{temple.address.join(', ')}. Open all day during the season.</p>
      <a class="d-btn" href={temple.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
      <a class="d-link" href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a>
    </footer>
  </main>

  <style is:global>
    .d { --night: #120c08; --night-2: #1d140d; --amber: #ffae42; --glow: #ffd28a; --text: #f3e6d3; --dim: #b9a38a;
      background: var(--night); color: var(--text); font: 400 1.0625rem/1.65 'Hind', system-ui, sans-serif; padding-bottom: 96px; }
    .d h1, .d h2, .d figcaption b, .d-sevas b { font-family: 'Tiro Kannada', 'Tiro Telugu', Georgia, serif; font-weight: 400; }
    .d-sc { font-family: 'Tiro Kannada', 'Tiro Telugu', serif; color: var(--amber); font-size: 1.25rem; }
    :root[data-script='te'] .d-sc { font-family: 'Tiro Telugu', serif; }
    .d p { margin: 0; }
    .d a { color: inherit; }
    .d-hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
    .d-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .d-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--night) 4%, rgb(18 12 8 / 0.75) 34%, rgb(18 12 8 / 0) 62%); }
    .d-hero__txt { position: relative; z-index: 1; padding: 0 max(18px, env(safe-area-inset-left)) 76px; display: grid; gap: 8px; justify-items: start; max-width: 760px; }
    .d-hero h1 { font-size: clamp(2.6rem, 1.6rem + 6vw, 5rem); line-height: 1.02; margin: 0; text-wrap: balance; text-shadow: 0 2px 24px rgb(0 0 0 / 0.5); }
    .d-hero__txt > p:not(.d-sc) { color: var(--glow); }
    .d-btn { display: inline-grid; place-items: center; min-height: 52px; padding: 0 26px; margin-top: 10px; border-radius: 999px; background: var(--amber); color: var(--night) !important; font-weight: 600; text-decoration: none; box-shadow: 0 0 30px rgb(255 174 66 / 0.35); }
    .d-link { display: inline-grid; align-items: center; min-height: 44px; text-underline-offset: 6px; text-decoration-color: var(--amber); }
    .d > section:not(.d-hero), .d-foot { padding: 48px max(18px, env(safe-area-inset-left)); max-width: 760px; margin-inline: auto; }
    .d h2 { font-size: clamp(1.9rem, 1.4rem + 2.6vw, 2.8rem); line-height: 1.1; margin: 0 0 16px; }
    .d-times { display: grid; gap: 4px; font-size: 1.125rem; }
    .d-times b { font-weight: 600; color: var(--amber); }
    .d-tonight ol { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 14px; }
    .d-tonight li { display: grid; padding-left: 16px; border-left: 2px solid var(--dim); }
    .d-tonight li[hidden] { display: none; }
    .d-tonight li.is-soon { border-color: var(--amber); }
    .d-tonight i { font-style: normal; color: var(--amber); font-weight: 600; }
    .d-tonight b { font-family: 'Tiro Kannada', serif; font-weight: 400; font-size: 1.5rem; line-height: 1.2; }
    .d-tonight span { color: var(--dim); }
    .d-tonight a { justify-self: start; display: inline-grid; align-items: center; min-height: 44px; }
    .d > section.d-strip { max-width: none; padding-inline: 0; }
    .d-strip h2, .d-strip > p, .d-strip > a { margin-inline: max(18px, env(safe-area-inset-left)); }
    .d-strip ul { list-style: none; margin: 0; padding: 0 max(18px, env(safe-area-inset-left)); display: grid; grid-auto-flow: column; grid-auto-columns: 58%; gap: 10px; overflow-x: auto; scroll-snap-type: inline proximity; scroll-padding-inline: max(18px, env(safe-area-inset-left)); scrollbar-width: none; }
    .d-strip li { scroll-snap-align: start; }
    .d-strip img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 3px; }
    .d-strip > p { color: var(--dim); font-size: 0.9375rem; margin-top: 12px; max-width: 60ch; }
    .d-quiet > p:not(.d-sc) { color: var(--dim); max-width: 60ch; }
    .d-people figure { margin: 0 0 22px; position: relative; }
    .d-people figure img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 3px; }
    .d-people figcaption { position: absolute; inset: auto 0 0; padding: 60px 16px 14px; display: grid; background: linear-gradient(transparent, rgb(18 12 8 / 0.92)); }
    .d-people figcaption b { font-size: 1.75rem; line-height: 1.1; }
    .d-people figcaption span { color: var(--glow); font-size: 0.9375rem; }
    .d-people ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .d-people li { display: grid; grid-template-columns: 60px 1fr; column-gap: 14px; align-items: center; }
    .d-people li img { grid-row: 1 / 3; width: 60px; height: 60px; border-radius: 50%; object-fit: cover; }
    .d-people li b { font-weight: 600; align-self: end; }
    .d-people li span { color: var(--dim); font-size: 0.9375rem; align-self: start; }
    .d-sevas { list-style: none; margin: 0; padding: 0; }
    .d-sevas a { display: grid; min-height: 64px; padding: 12px 0; border-bottom: 1px solid rgb(255 174 66 / 0.25); text-decoration: none; }
    .d-sevas b { font-size: 1.625rem; line-height: 1.2; }
    .d-sevas span { color: var(--dim); font-size: 0.9375rem; }
    .d-foot { display: grid; gap: 10px; justify-items: start; }
    @media (min-width: 760px) { .d-strip ul { grid-auto-columns: 24%; } }
  </style>
</Mock>
