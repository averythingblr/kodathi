---
import Sc from '../components/Sc.astro';
import Base from '../layouts/Base.astro';
import { temple, schedule, offerings } from '../data/temple';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fmt = (min: number) => {
  const h = Math.floor(min / 60), m = min % 60;
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')}`;
};
const ampm = (min: number) => (min < 720 ? 'am' : 'pm');
const morning = schedule.filter((p) => p.at < 13 * 60);
const evening = schedule.filter((p) => p.at >= 13 * 60);
const wa = (s: string) => `https://wa.me/${temple.whatsapp}?text=${encodeURIComponent(s)}`;
---
<Base page="poojas" title="Poojas and timings" description="Daily pooja timings at the Ayyappa Swamy Temple, Kodathi, and how to book padi pooja, neyyabhishekam, archana and annadanam.">
  <section class="page-hero">
    <div class="page-hero__media"><img src={`${base}media/film/aarti-poster.jpg`} alt="" /></div>
    <div class="wrap">
      <Sc tag="p" kn="ಪೂಜೆಗಳು" te="పూజలు" class="eyebrow-sc" />
      <h1 class="t-1">Poojas and timings</h1>
      <p class="lede" style="margin-top:20px">The sanctum opens twice a day. Here is what happens and when, and how to book a seva. Padi pooja is not daily: it is offered on Thursday evenings at the temple, not every week, and at homes on request.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="placeholder-note" data-rise>Timings are being confirmed by the temple and may change during Mandala season.</p>
      <div class="days">
        {[{ t: 'Morning', l: morning }, { t: 'Evening', l: evening }].map((g) => (
          <div class="day-col" data-rise>
            <h2 class="t-2">{g.t}</h2>
            <ol class="tl">
              {g.l.map((p) => (
                <li class={`tl__row tl__row--${p.kind}`}>
                  <span class="tl__t num">{fmt(p.at)}<small>{ampm(p.at)}</small></span>
                  <div>
                    <h3>{p.name} <Sc kn={p.kn} te={p.te} class="tl__sc" /></h3>
                    <p>{p.note}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section offerings" id="offerings">
    <div class="wrap">
      <div class="off-head">
        <h2 class="t-1" data-rise>Sevas</h2>
        <p class="lede" data-rise>Message the temple office on WhatsApp with the seva, the date and the names and stars to be chanted. They will confirm and tell you what to bring.</p>
      </div>
      <ul class="off-grid">
        {offerings.map((o) => (
          <li class="off" data-rise>
            <Sc tag="p" kn={o.kn} te={o.te} class="off__sc" />
            <h3 class="t-3">{o.name}</h3>
            <p>{o.what}</p>
            <p class="small">{o.when}</p>
            <a class="off__link" href={wa(`Swamiye Sharanam. I would like to book ${o.name}.`)} target="_blank" rel="noopener">Book on WhatsApp</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .days { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); margin-top: 40px; }
  .days > * { min-width: 0; }
  .tl { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .tl__row { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .tl__t { font-family: var(--display); font-size: 30px; line-height: 1; color: var(--head); }
  .tl__t small { font-family: var(--body); font-size: 13px; color: var(--sub); margin-left: 4px; }
  .tl h3 { font-family: var(--body); font-weight: 500; font-size: 19px; color: var(--head); }
  .tl h3 :global(.tl__sc) { font-weight: 500; font-size: 14px; color: var(--sub); margin-left: 6px; }
  .tl p { color: var(--fg); margin-top: 4px; font-size: 16px; }
  .tl__row--close .tl__t, .tl__row--close h3 { color: var(--sub); }
  .offerings { background: var(--soot); }
  .off-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: end; }
  .off-grid { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; background: var(--rule); }
  .off { background: var(--soot); padding: 28px 26px 30px; display: grid; gap: 10px; align-content: start; }
  .off :global(.off__sc) { color: var(--brass); font-size: 15px; }
  .off .t-3 { color: var(--head); }
  .off__link { color: var(--acc); margin-top: 6px; text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .days, .off-head { grid-template-columns: minmax(0, 1fr); }
    .off-grid { grid-template-columns: minmax(0, 1fr); }
    .tl__row { grid-template-columns: 76px minmax(0, 1fr); }
  }
</style>
