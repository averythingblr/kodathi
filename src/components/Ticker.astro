---
// A scrolling notice for what is happening today or tomorrow: a padi pooja at a swamy's home,
// a festival. Every dated event is rendered; the script keeps only today's and tomorrow's
// (IST) and stays hidden when there are none.
import { festivals, padiPoojas, padiTitle } from '../data/temple';
interface Props { variant?: 'bar' | 'band'; label?: string }
const { variant = 'band', label = 'Happening soon' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const items = [
  ...padiPoojas.map((p) => ({ date: p.date, title: padiTitle(p), when: p.when })),
  ...festivals.filter((f) => !f.ongoing).map((f) => ({ date: f.start, title: f.name, when: '' })),
].sort((a, b) => a.date.localeCompare(b.date));
---
{items.length > 0 && (
  <a class={`tk tk--${variant}`} href={`${base}festivals/`} data-ticker hidden aria-label={label}>
    <span class="tk__tag" aria-hidden="true"><span class="tk__dot"></span><span data-tk-tag>Today</span></span>
    <span class="tk__win">
      <span class="sr-only" data-tk-sr></span>
      <span class="tk__track" data-tk-track aria-hidden="true"></span>
    </span>
    <template data-tk-items>
      {items.map((it) => <i data-date={it.date} data-title={it.title} data-when={it.when}></i>)}
    </template>
  </a>
)}

<script>
  const ymd = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(d);
  const now = new Date();
  const today = ymd(now), tomorrow = ymd(new Date(now.getTime() + 86400000));
  document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((tk) => {
    const tpl = tk.querySelector<HTMLTemplateElement>('[data-tk-items]')!;
    const soon = [...tpl.content.querySelectorAll<HTMLElement>('i')]
      .filter((i) => i.dataset.date === today || i.dataset.date === tomorrow)
      .map((i) => {
        const day = i.dataset.date === today ? (i.dataset.when === 'Evening' ? 'This evening' : 'Today') : (i.dataset.when === 'Evening' ? 'Tomorrow evening' : 'Tomorrow');
        return { day, isToday: i.dataset.date === today, title: i.dataset.title! };
      });
    if (!soon.length) return;
    tk.querySelector('[data-tk-tag]')!.textContent = soon.some((s) => s.isToday) ? 'Today' : 'Tomorrow';
    const line = soon.map((s) => `${s.day}: ${s.title}`).join('   ✦   ');
    tk.querySelector('[data-tk-sr]')!.textContent = line + '. See events.';
    const track = tk.querySelector<HTMLElement>('[data-tk-track]')!;
    // the line repeats so the loop has no gap; the track moves by exactly one half
    const unit = `<span class="tk__item">${line.replace(/&/g, '&amp;').replace(/</g, '&lt;')}<span class="tk__sep">✦ Swamiye Sharanam ✦</span></span>`;
    track.innerHTML = unit.repeat(4);
    tk.hidden = false;
    track.style.setProperty('--tk-dur', `${Math.max(14, line.length * 0.28)}s`);
  });
</script>

<style>
  .tk { position: relative; display: flex; align-items: stretch; overflow: hidden; text-decoration: none; color: #2a1606; background: linear-gradient(90deg, #ffb547, #ffcf7a 50%, #ffb547); }
  .tk[hidden] { display: none; }
  .tk:focus-visible { outline: 2px solid #fff1d6; outline-offset: -4px; }
  .tk__tag { position: relative; z-index: 1; flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 0 16px 0 max(16px, var(--gutter)); background: #1a0f06; color: #ffcf7a; font: 600 13px/1 var(--body); letter-spacing: .08em; text-transform: uppercase; }
  .tk__dot { width: 8px; height: 8px; border-radius: 50%; background: #ff7a3c; box-shadow: 0 0 0 0 rgba(255,122,60,.7); animation: tk-ping 1.6s ease-out infinite; }
  .tk__win { position: relative; flex: 1; min-width: 0; overflow: hidden; display: flex; align-items: center; -webkit-mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
  .tk__track { display: inline-flex; white-space: nowrap; animation: tk-run var(--tk-dur, 20s) linear infinite; will-change: transform; }
  .tk:hover .tk__track, .tk:focus-visible .tk__track { animation-play-state: paused; }
  .tk :global(.tk__item) { display: inline-flex; align-items: center; padding-left: 28px; font: 500 15px/1 var(--body); }
  .tk :global(.tk__sep) { padding-left: 28px; color: #8a4a10; font-weight: 400; }
  .tk--bar { height: 34px; pointer-events: auto; }
  .tk--band { height: 64px; margin-block: 0; }
  .tk--band .tk__tag { font-size: 14px; padding-right: 22px; }
  .tk--band :global(.tk__item) { font-size: clamp(17px, 1.8vw, 22px); font-family: var(--display); font-weight: 400; }
  @keyframes tk-run { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes tk-ping { 0% { box-shadow: 0 0 0 0 rgba(255,122,60,.7); } 80%, 100% { box-shadow: 0 0 0 9px rgba(255,122,60,0); } }
  @media (prefers-reduced-motion: reduce) {
    .tk__track { animation: none; }
    .tk__dot { animation: none; }
  }
</style>
