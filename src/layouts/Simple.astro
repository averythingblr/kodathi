---
// The simple site: a calm, white, multi-page website for the same temple (the main site is the grand one).
// No gate, no films, no sound unless a visitor taps. Pages live under /simple/.
import '@fontsource/playfair-display/400.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/noto-sans-kannada/400.css';
import '@fontsource/noto-sans-telugu/400.css';
import '@fontsource/tiro-kannada/400.css';
import '@fontsource/tiro-telugu/400.css';
import '../styles/simple.css';
import Logo from '../components/Logo.astro';
import { temple } from '../data/temple';
import { simpleNav, type SPage } from '../data/simpleNav';

interface Props { title?: string; description?: string; page: SPage }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = `${base}simple/`;
const fullTitle = title ? `${title} | ${temple.name}, ${temple.place}` : `${temple.name}, ${temple.place}`;
const desc = description ?? 'Ayyappa Swamy Temple on Kodati–Sulikunte Road, Kodathi, Bengaluru. Pooja timings, padi pooja, maala dharana, sevas, events and directions.';
const nav = simpleNav(base);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#a77a48" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(`${base}media/gallery/2026-11-12-padi-pooja-temple/photo-1.jpg`, Astro.site).href} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>try{var s=localStorage.getItem('kodathi-script');if(s==='te'||s==='kn')document.documentElement.dataset.script=s}catch(e){}</script>
  </head>
  <body class="s" data-base={base} data-page={page} data-events-page={`${home}events/`}>
    <a class="s-skip" href="#main">Skip to content</a>
    <p class="s-strip" data-note><span aria-hidden="true">✦</span> <span data-note-text>{temple.chant.en}</span> <span aria-hidden="true">✦</span></p>
    <header class="s-bar">
      <div class="s-wrap s-bar__in">
        <a class="s-brand" href={home} aria-label={`${temple.name}, ${temple.place}: home`}>
          <Logo />
          <span><b>{temple.name}</b><small>Kodathi, Bengaluru</small></span>
        </a>
        <nav class="s-nav" aria-label="Main">
          {nav.map((l) => <a href={l.href} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <div class="s-bar__ctl">
          <button class="s-script" type="button" data-script-toggle aria-label="Show Kannada or Telugu script">
            <span lang="kn" data-on="kn">ಕ</span><span aria-hidden="true">/</span><span lang="te" data-on="te">తె</span>
          </button>
          <button class="s-menu-btn" type="button" data-menu-open aria-haspopup="dialog"><i aria-hidden="true"><b></b></i>Menu</button>
        </div>
      </div>
    </header>

    <dialog class="s-menu" data-menu aria-label="Site menu">
      <div class="s-menu__top">
        <p class="s-menu__name">{temple.name}</p>
        <button class="s-menu__close" type="button" data-menu-close>Close</button>
      </div>
      <nav aria-label="Menu">
        <ul>{nav.map((l) => <li><a href={l.href} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a></li>)}</ul>
      </nav>
      <div class="s-menu__foot">
        <a class="s-btn" href={temple.mapUrl} target="_blank" rel="noopener">Directions</a>
        <a class="s-btn s-btn--line" href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </dialog>

    <main id="main">
      <slot />
    </main>

    <footer class="s-foot">
      <div class="s-wrap s-foot__in">
        <div>
          <p class="s-foot__name">{temple.name}, {temple.place}</p>
          <p>{temple.address.join(', ')}</p>
          <p><a href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a></p>
        </div>
        <nav aria-label="Footer">
          <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      </div>
      <div class="s-wrap s-foot__end">
        <p>© 2026 {temple.name}, {temple.place}</p>
        <a href={base}>See the full website with films and sound</a>
      </div>
    </footer>

    <script>
      import '../scripts/simple';
    </script>
  </body>
</html>
