---
import '@fontsource/tiro-kannada/400.css';
import '@fontsource/tiro-kannada/400-italic.css';
import '@fontsource/tiro-telugu/400.css';
import '@fontsource/hind/400.css';
import '@fontsource/hind/500.css';
import '@fontsource/hind/600.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Sc from '../components/Sc.astro';
import Ticker from '../components/Ticker.astro';
import { temple } from '../data/temple';

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'gallery' | 'poojas' | 'festivals' | 'visit' | 'other';
  footer?: boolean;
  image?: string;
}
const { title, description, page, footer = true, image = 'media/film/steps-poster.jpg' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} | ${temple.name}, ${temple.place}` : `${temple.name}, ${temple.place}`;
const desc = description ?? 'Ayyappa Swamy Temple on Kodati–Sulikunte Road, Bengaluru. Daily poojas, padi pooja, maala dharana, festivals, sevas and directions.';
const links = [
  { href: base, label: 'Home', kn: '', te: '', key: 'home' },
  { href: `${base}gallery/`, label: 'Gallery', kn: '', te: '', key: 'gallery' },
  { href: `${base}poojas/`, label: 'Poojas and timings', kn: 'ಪೂಜೆಗಳು', te: 'పూజలు', key: 'poojas' },
  { href: `${base}festivals/`, label: 'Events and festivals', kn: '', te: '', key: 'festivals' },
  { href: `${base}visit/`, label: 'Visit', kn: '', te: '', key: 'visit' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#15110d" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(`${base}${image}`, Astro.site).href} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>try{var s=localStorage.getItem('kodathi-script');if(s==='te'||s==='kn')document.documentElement.dataset.script=s}catch(e){}</script>
    <slot name="head" />
  </head>
  <body data-page={page} data-base={base}>
    <a class="skip" href="#main">Skip to content</a>

    <header class="head">
      <Ticker variant="bar" label="Happening today or tomorrow. See events." />
      <div class="wrap head__in">
        <a class="brand" href={base} aria-label={`${temple.name}, ${temple.place}: home`}>
          <b>{temple.name}</b>
          <span>{temple.place}, Bengaluru</span>
        </a>
        <div class="head__ctl">
          <button class="pill pill--script" type="button" data-script-toggle aria-label="Show Kannada or Telugu script">
            <span lang="kn" data-on="kn">ಕ</span><span aria-hidden="true">/</span><span lang="te" data-on="te">తె</span>
          </button>
          <button class="pill" type="button" data-sound-toggle aria-pressed="false">
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
            <span data-sound-label>Sound off</span>
          </button>
          <button class="pill" type="button" data-menu-open aria-expanded="false" aria-controls="menu">Menu</button>
        </div>
      </div>
    </header>

    <div class="menu" id="menu" data-menu inert role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="wrap menu__top">
        <a class="brand" href={base}><b>{temple.name}</b><span>{temple.place}, Bengaluru</span></a>
        <button class="pill" type="button" data-menu-close>Close</button>
      </div>
      <nav class="wrap" aria-label="Main">
        <ol>
          {links.map((l) => (
            <li><a href={l.href} aria-current={page === l.key ? 'page' : undefined}>{l.label}<Sc tag="small" kn={l.kn} te={l.te} /></a></li>
          ))}
        </ol>
      </nav>
      <div class="wrap menu__foot">
        <span>{temple.address.join(', ')}</span>
        <a href={temple.mapUrl} target="_blank" rel="noopener">Open in Maps</a>
        <a href={`https://wa.me/${temple.whatsapp}`} target="_blank" rel="noopener">WhatsApp {temple.whatsappDisplay}</a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    {footer && <Footer base={base} />}

    <script>
      import { initScroll, initChrome, initReveals } from '../scripts/core';
      initChrome();
      if (document.body.dataset.page !== 'home') { initScroll(); initReveals(); }
    </script>
  </body>
</html>
