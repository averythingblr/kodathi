---
// Frame for the five design mockups: real content, phone first, and a small bar to step between them.
import { temple } from '../data/temple';
interface Props { n: number; name: string; theme: string }
const { n, name, theme } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const names = ['Karuppu', 'Padi', 'Calendar', 'Notice board', 'Deepam'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content={theme} />
    <title>{`Mockup ${n}: ${name} | ${temple.name}, ${temple.place}`}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>try{var s=localStorage.getItem('kodathi-script');if(s==='te'||s==='kn')document.documentElement.dataset.script=s}catch(e){}</script>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; overflow-x: clip; }
      body { margin: 0; }
      img, video, svg { display: block; max-width: 100%; height: auto; }
      :root:not([data-script='te']) [data-sc='te'], :root[data-script='te'] [data-sc='kn'] { display: none !important; }
      .mk-bar { position: fixed; z-index: 99; left: 50%; bottom: max(10px, env(safe-area-inset-bottom)); transform: translateX(-50%); display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px; background: rgb(20 18 14 / 0.88); color: #fff; font: 500 0.875rem/1 system-ui, sans-serif; backdrop-filter: blur(8px); box-shadow: 0 6px 20px rgb(0 0 0 / 0.3); }
      .mk-bar a, .mk-bar button { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 10px; border: 0; border-radius: 999px; background: none; color: inherit; text-decoration: none; font: inherit; cursor: pointer; }
      .mk-bar [aria-current='page'] { background: #fff; color: #111; }
      .mk-bar .mk-sc { font-family: 'Noto Sans Kannada', 'Noto Sans Telugu', system-ui; }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <nav class="mk-bar" aria-label="Mockups">
      {names.map((nm, i) => <a href={`${base}mockups/${i + 1}/`} aria-current={i + 1 === n ? 'page' : undefined} aria-label={`Mockup ${i + 1}: ${nm}`}>{i + 1}</a>)}
      <button class="mk-sc" type="button" data-script-toggle aria-label="Show Kannada or Telugu script"><span data-sc="kn" lang="kn">ಕ</span><span data-sc="te" lang="te">తె</span></button>
    </nav>
    <script is:inline>
      // events: past ones hide; in a [data-only-next] list only the first upcoming one shows
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date());
        var at = function (s) { return new Date(s + 'T00:00:00+05:30').getTime(); };
        document.querySelectorAll('[data-events]').forEach(function (list) {
          var shown = 0, max = +(list.dataset.events || 99);
          list.querySelectorAll('[data-date]').forEach(function (el) {
            var left = Math.round((at(el.dataset.date) - at(today)) / 864e5);
            if (left < 0 || shown >= max) { el.hidden = true; return; }
            shown++;
            var w = el.querySelector('[data-left]');
            if (w) w.textContent = left === 0 ? 'Today' : left === 1 ? 'Tomorrow' : 'In ' + left + ' days';
            if (left <= 1) el.classList.add('is-soon');
          });
        });
      })();
      document.querySelectorAll('[data-script-toggle]').forEach(function (b) { b.addEventListener('click', function () { var n = document.documentElement.dataset.script === 'te' ? 'kn' : 'te'; document.documentElement.dataset.script = n; try { localStorage.setItem('kodathi-script', n); } catch (e) {} }); });
    </script>
  </body>
</html>
