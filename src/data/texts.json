 {
  "id": "namaskara-shlokas",
  "kind": "verses",
  "name": "Shasta namaskara shlokas",
  "title": {
   "en": "atha śāstā namaskāra ślōkāḥ",
   "kn": "ಅಥ ಶಾಸ್ತಾ ನಮಸ್ಕಾರ ಶ್ಲೋಕಾಃ",
   "te": "అథ శాస్తా నమస్కార శ్లోకాః"
  },
  "verses": [
   {
    "n": 1,
    "lines": [
     {
      "en": "trayambakapurādhīśaṃ gaṇādhipasamanvitam ।",
      "kn": "ತ್ರಯಂಬಕಪುರಾಧೀಶಂ ಗಣಾಧಿಪಸಮನ್ವಿತಮ್ ।",
      "te": "త్రయంబకపురాధీశం గణాధిపసమన్వితమ్ ।"
     },
     {
      "en": "gajārūḍhamahaṃ vandē śāstāraṃ praṇamāmyaham ॥ 1 ॥",
      "kn": "ಗಜಾರೂಢಮಹಂ ವಂದೇ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 1 ॥",
      "te": "గజారూఢమహం వందే శాస్తారం ప్రణమామ్యహమ్ ॥ 1 ॥"
     }
    ]
   },
   {
    "n": 2,
    "lines": [
     {
      "en": "śivavīryasamudbhūtaṃ śrīnivāsatanūdbhavam ।",
      "kn": "ಶಿವವೀರ್ಯಸಮುದ್ಭೂತಂ ಶ್ರೀನಿವಾಸತನೂದ್ಭವಮ್ ।",
      "te": "శివవీర్యసముద్భూతం శ్రీనివాసతనూద్భవమ్ ।"
     },
     {
      "en": "śikhivāhānujaṃ vandē śāstāraṃ praṇamāmyaham ॥ 2 ॥",
      "kn": "ಶಿಖಿವಾಹಾನುಜಂ ವಂದೇ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 2 ॥",
      "te": "శిఖివాహానుజం వందే శాస్తారం ప్రణమామ్యహమ్ ॥ 2 ॥"
     }
    ]
   },
   {
    "n": 3,
    "lines": [
     {
      "en": "yasya dhanvantarirmātā pitā dēvō mahēśvaraḥ ।",
      "kn": "ಯಸ್ಯ ಧನ್ವಂತರಿರ್ಮಾತಾ ಪಿತಾ ದೇವೋ ಮಹೇಶ್ವರಃ ।",
      "te": "యస్య ధన్వంతరిర్మాతా పితా దేవో మహేశ్వరః ।"
     },
     {
      "en": "taṃ śāstāramahaṃ vandē mahārōganivāraṇam ॥ 3 ॥",
      "kn": "ತಂ ಶಾಸ್ತಾರಮಹಂ ವಂದೇ ಮಹಾರೋಗನಿವಾರಣಮ್ ॥ 3 ॥",
      "te": "తం శాస్తారమహం వందే మహారోగనివారణమ్ ॥ 3 ॥"
     }
    ]
   },
   {
    "n": 4,
    "lines": [
     {
      "en": "bhūtanātha sadānanda sarvabhūtadayāpara ।",
      "kn": "ಭೂತನಾಥ ಸದಾನಂದ ಸರ್ವಭೂತದಯಾಪರ ।",
      "te": "భూతనాథ సదానంద సర్వభూతదయాపర ।"
     },
     {
      "en": "rakṣa rakṣa mahābāhō śāstrē tubhyaṃ namō namaḥ ॥ 4 ॥",
      "kn": "ರಕ್ಷ ರಕ್ಷ ಮಹಾಬಾಹೋ ಶಾಸ್ತ್ರೇ ತುಭ್ಯಂ ನಮೋ ನಮಃ ॥ 4 ॥",
      "te": "రక్ష రక్ష మహాబాహో శాస్త్రే తుభ్యం నమో నమః ॥ 4 ॥"
     }
    ]
   }
  ],
  "source": {
   "name": "Vaidika Vignanam",
   "en": "https://vignanam.org/english/ayyappa-pancha-ratnam.html",
   "kn": "https://vignanam.org/kannada/ayyappa-pancha-ratnam.html",
   "te": "https://vignanam.org/telugu/ayyappa-pancha-ratnam.html"
  }
 },
 {
  "id": "ayyappa-stotram",
  "kind": "verses",
  "name": "Ayyappa stotram",
  "title": {
   "en": "Ayyappa Stotram",
   "kn": "ಅಯ್ಯಪ್ಪ ಸ್ತೋತ್ರಂ",
   "te": "అయ్యప్ప స్తోత్రం"
  },
  "verses": [
   {
    "n": 1,
    "lines": [
     {
      "en": "aruṇōdayasaṅkāśaṃ nīlakuṇḍaladhāraṇam ।",
      "kn": "ಅರುಣೋದಯಸಂಕಾಶಂ ನೀಲಕುಂಡಲಧಾರಣಮ್ ।",
      "te": "అరుణోదయసంకాశం నీలకుండలధారణమ్ ।"
     },
     {
      "en": "nīlāmbaradharaṃ dēvaṃ vandē'haṃ brahmanandanam ॥ 1 ॥",
      "kn": "ನೀಲಾಂಬರಧರಂ ದೇವಂ ವಂದೇಽಹಂ ಬ್ರಹ್ಮನಂದನಮ್ ॥ 1 ॥",
      "te": "నీలాంబరధరం దేవం వందేఽహం బ్రహ్మనందనమ్ ॥ 1 ॥"
     }
    ]
   },
   {
    "n": 2,
    "lines": [
     {
      "en": "chāpabāṇaṃ vāmahastē raupyavītraṃ cha dakṣiṇē । [chinmudrāṃ dakṣiṇakarē]",
      "kn": "ಚಾಪಬಾಣಂ ವಾಮಹಸ್ತೇ ರೌಪ್ಯವೀತ್ರಂ ಚ ದಕ್ಷಿಣೇ । [ಚಿನ್ಮುದ್ರಾಂ ದಕ್ಷಿಣಕರೇ]",
      "te": "చాపబాణం వామహస్తే రౌప్యవీత్రం చ దక్షిణే । [చిన్ముద్రాం దక్షిణకరే]"
     },
     {
      "en": "vilasatkuṇḍaladharaṃ vandē'haṃ viṣṇunandanam ॥ 2 ॥",
      "kn": "ವಿಲಸತ್ಕುಂಡಲಧರಂ ವಂದೇಽಹಂ ವಿಷ್ಣುನಂದನಮ್ ॥ 2 ॥",
      "te": "విలసత్కుండలధరం వందేఽహం విష్ణునందనమ్ ॥ 2 ॥"
     }
    ]
   },
   {
    "n": 3,
    "lines": [
     {
      "en": "vyāghrārūḍhaṃ raktanētraṃ svarṇamālāvibhūṣaṇam ।",
      "kn": "ವ್ಯಾಘ್ರಾರೂಢಂ ರಕ್ತನೇತ್ರಂ ಸ್ವರ್ಣಮಾಲಾವಿಭೂಷಣಮ್ ।",
      "te": "వ్యాఘ్రారూఢం రక్తనేత్రం స్వర్ణమాలావిభూషణమ్ ।"
     },
     {
      "en": "vīrāpaṭṭadharaṃ dēvaṃ vandē'haṃ śambhunandanam ॥ 3 ॥",
      "kn": "ವೀರಾಪಟ್ಟಧರಂ ದೇವಂ ವಂದೇಽಹಂ ಶಂಭುನಂದನಮ್ ॥ 3 ॥",
      "te": "వీరాపట్టధరం దేవం వందేఽహం శంభునందనమ్ ॥ 3 ॥"
     }
    ]
   },
   {
    "n": 4,
    "lines": [
     {
      "en": "kiṅkiṇyōḍyāna bhūtēśaṃ pūrṇachandranibhānanam ।",
      "kn": "ಕಿಂಕಿಣ್ಯೋಡ್ಯಾನ ಭೂತೇಶಂ ಪೂರ್ಣಚಂದ್ರನಿಭಾನನಮ್ ।",
      "te": "కింకిణ్యోడ్యాన భూతేశం పూర్ణచంద్రనిభాననమ్ ।"
     },
     {
      "en": "kirātarūpa śāstāraṃ vandē'haṃ pāṇḍyanandanam ॥ 4 ॥",
      "kn": "ಕಿರಾತರೂಪ ಶಾಸ್ತಾರಂ ವಂದೇಽಹಂ ಪಾಂಡ್ಯನಂದನಮ್ ॥ 4 ॥",
      "te": "కిరాతరూప శాస్తారం వందేఽహం పాండ్యనందనమ్ ॥ 4 ॥"
     }
    ]
   },
   {
    "n": 5,
    "lines": [
     {
      "en": "bhūtabhētāḻasaṃsēvyaṃ kāñchanādrinivāsitam ।",
      "kn": "ಭೂತಭೇತಾಳಸಂಸೇವ್ಯಂ ಕಾಂಚನಾದ್ರಿನಿವಾಸಿತಮ್ ।",
      "te": "భూతభేతాళసంసేవ్యం కాంచనాద్రినివాసితమ్ ।"
     },
     {
      "en": "maṇikaṇṭhamiti khyātaṃ vandē'haṃ śaktinandanam ॥ 5 ॥",
      "kn": "ಮಣಿಕಂಠಮಿತಿ ಖ್ಯಾತಂ ವಂದೇಽಹಂ ಶಕ್ತಿನಂದನಮ್ ॥ 5 ॥",
      "te": "మణికంఠమితి ఖ్యాతం వందేఽహం శక్తినందనమ్ ॥ 5 ॥"
     }
    ]
   },
   {
    "n": null,
    "lines": [
     {
      "en": "iti śrī ayyappa stōtram ।",
      "kn": "ಇತಿ ಶ್ರೀ ಅಯ್ಯಪ್ಪ ಸ್ತೋತ್ರಮ್ ।",
      "te": "ఇతి శ్రీ అయ్యప్ప స్తోత్రమ్ ।"
     }
    ]
   }
  ],
  "source": {
   "name": "Vaidika Vignanam",
   "en": "https://vignanam.org/english/ayyappa-stotram.html",
   "kn": "https://vignanam.org/kannada/ayyappa-stotram.html",
   "te": "https://vignanam.org/telugu/ayyappa-stotram.html"
  }
 },
 {
  "id": "harivarasanam",
  "kind": "verses",
  "name": "Harivarasanam",
  "title": {
   "en": "Harivarasanam",
   "kn": "ಹರಿವರಾಸನಂ",
   "te": "హరివరాసనం"
  },
  "verses": [
   {
    "n": 1,
    "lines": [
     {
      "en": "harivarāsanaṃ viśvamōhanam",
      "kn": "ಹರಿವರಾಸನಂ ವಿಶ್ವಮೋಹನಂ",
      "te": "హరివరాసనం విశ్వమోహనం"
     },
     {
      "en": "haridadhīśvaraṃ ārādhyapādukam ।",
      "kn": "ಹರಿದಧೀಶ್ವರಂ ಆರಾಧ್ಯಪಾದುಕಮ್ ।",
      "te": "హరిదధీశ్వరం ఆరాధ్యపాదుకమ్ ।"
     },
     {
      "en": "arivimardanaṃ nityanartanam",
      "kn": "ಅರಿವಿಮರ್ದನಂ ನಿತ್ಯನರ್ತನಂ",
      "te": "అరివిమర్దనం నిత్యనర్తనం"
     },
     {
      "en": "hariharātmajaṃ dēvamāśrayē ॥ 1 ॥",
      "kn": "ಹರಿಹರಾತ್ಮಜಂ ದೇವಮಾಶ್ರಯೇ ॥ 1 ॥",
      "te": "హరిహరాత్మజం దేవమాశ్రయే ॥ 1 ॥"
     }
    ]
   },
   {
    "n": 2,
    "lines": [
     {
      "en": "śaraṇakīrtanaṃ bhaktamānasam",
      "kn": "ಶರಣಕೀರ್ತನಂ ಭಕ್ತಮಾನಸಂ",
      "te": "శరణకీర్తనం భక్తమానసం"
     },
     {
      "en": "bharaṇalōlupaṃ nartanālasam ।",
      "kn": "ಭರಣಲೋಲುಪಂ ನರ್ತನಾಲಸಮ್ ।",
      "te": "భరణలోలుపం నర్తనాలసమ్ ।"
     },
     {
      "en": "aruṇabhāsuraṃ bhūtanāyakam",
      "kn": "ಅರುಣಭಾಸುರಂ ಭೂತನಾಯಕಂ",
      "te": "అరుణభాసురం భూతనాయకం"
     },
     {
      "en": "hariharātmajaṃ dēvamāśrayē ॥ 2 ॥",
      "kn": "ಹರಿಹರಾತ್ಮಜಂ ದೇವಮಾಶ್ರಯೇ ॥ 2 ॥",
      "te": "హరిహరాత్మజం దేవమాశ్రయే ॥ 2 ॥"
     }
    ]
   },
   {
    "n": 3,
    "lines": [
     {
      "en": "praṇayasatyakaṃ prāṇanāyakam",
      "kn": "ಪ್ರಣಯಸತ್ಯಕಂ ಪ್ರಾಣನಾಯಕಂ",
      "te": "ప్రణయసత్యకం ప్రాణనాయకం"
     },
     {
      "en": "praṇatakalpakaṃ suprabhāñchitam ।",
      "kn": "ಪ್ರಣತಕಲ್ಪಕಂ ಸುಪ್ರಭಾಂಚಿತಮ್ ।",
      "te": "ప్రణతకల్పకం సుప్రభాంచితమ్ ।"
     },
     {
      "en": "praṇavamandiraṃ kīrtanapriyam",
      "kn": "ಪ್ರಣವಮಂದಿರಂ ಕೀರ್ತನಪ್ರಿಯಂ",
      "te": "ప్రణవమందిరం కీర్తనప్రియం"
     },
     {
      "en": "hariharātmajaṃ dēvamāśrayē ॥ 3 ॥",
      "kn": "ಹರಿಹರಾತ್ಮಜಂ ದೇವಮಾಶ್ರಯೇ ॥ 3 ॥",
      "te": "హరిహరాత్మజం దేవమాశ్రయే ॥ 3 ॥"
     }
    ]
   },
   {
    "n": 4,
    "lines": [
     {
      "en": "turagavāhanaṃ sundarānanam",
      "kn": "ತುರಗವಾಹನಂ ಸುಂದರಾನನಂ",
      "te": "తురగవాహనం సుందరాననం"
     },
