 {
  "id": "loka-veeram",
  "kind": "verses",
  "name": "Loka Veeram",
  "title": {
   "en": "Ayyappa Pancha Ratnam",
   "kn": "ಅಯ್ಯಪ್ಪ ಪಂಚ ರತ್ನಂ",
   "te": "అయ్యప్ప పంచ రత్నం"
  },
  "verses": [
   {
    "n": 1,
    "lines": [
     {
      "en": "lōkavīraṃ mahāpūjyaṃ sarvarakṣākaraṃ vibhum ।",
      "kn": "ಲೋಕವೀರಂ ಮಹಾಪೂಜ್ಯಂ ಸರ್ವರಕ್ಷಾಕರಂ ವಿಭುಮ್ ।",
      "te": "లోకవీరం మహాపూజ్యం సర్వరక్షాకరం విభుమ్ ।"
     },
     {
      "en": "pārvatī hṛdayānandaṃ śāstāraṃ praṇamāmyaham ॥ 1 ॥",
      "kn": "ಪಾರ್ವತೀ ಹೃದಯಾನಂದಂ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 1 ॥",
      "te": "పార్వతీ హృదయానందం శాస్తారం ప్రణమామ్యహమ్ ॥ 1 ॥"
     }
    ]
   },
   {
    "n": 2,
    "lines": [
     {
      "en": "viprapūjyaṃ viśvavandyaṃ viṣṇuśambhōḥ priyaṃ sutam ।",
      "kn": "ವಿಪ್ರಪೂಜ್ಯಂ ವಿಶ್ವವಂದ್ಯಂ ವಿಷ್ಣುಶಂಭೋಃ ಪ್ರಿಯಂ ಸುತಮ್ ।",
      "te": "విప్రపూజ్యం విశ్వవంద్యం విష్ణుశంభోః ప్రియం సుతమ్ ।"
     },
     {
      "en": "kṣipraprasādanirataṃ śāstāraṃ praṇamāmyaham ॥ 2 ॥",
      "kn": "ಕ್ಷಿಪ್ರಪ್ರಸಾದನಿರತಂ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 2 ॥",
      "te": "క్షిప్రప్రసాదనిరతం శాస్తారం ప్రణమామ్యహమ్ ॥ 2 ॥"
     }
    ]
   },
   {
    "n": 3,
    "lines": [
     {
      "en": "mattamātaṅgagamanaṃ kāruṇyāmṛtapūritam ।",
      "kn": "ಮತ್ತಮಾತಂಗಗಮನಂ ಕಾರುಣ್ಯಾಮೃತಪೂರಿತಮ್ ।",
      "te": "మత్తమాతంగగమనం కారుణ్యామృతపూరితమ్ ।"
     },
     {
      "en": "sarvavighnaharaṃ dēvaṃ śāstāraṃ praṇamāmyaham ॥ 3 ॥",
      "kn": "ಸರ್ವವಿಘ್ನಹರಂ ದೇವಂ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 3 ॥",
      "te": "సర్వవిఘ్నహరం దేవం శాస్తారం ప్రణమామ్యహమ్ ॥ 3 ॥"
     }
    ]
   },
   {
    "n": 4,
    "lines": [
     {
      "en": "asmatkulēśvaraṃ dēvam-asmachChatru vināśanam ।",
      "kn": "ಅಸ್ಮತ್ಕುಲೇಶ್ವರಂ ದೇವಂ-ಅಸ್ಮಚ್ಛತ್ರು ವಿನಾಶನಮ್ ।",
      "te": "అస్మత్కులేశ్వరం దేవం-అస్మచ్ఛత్రు వినాశనమ్ ।"
     },
     {
      "en": "asmadiṣṭapradātāraṃ śāstāraṃ praṇamāmyaham ॥ 4 ॥",
      "kn": "ಅಸ್ಮದಿಷ್ಟಪ್ರದಾತಾರಂ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 4 ॥",
      "te": "అస్మదిష్టప్రదాతారం శాస్తారం ప్రణమామ్యహమ్ ॥ 4 ॥"
     }
    ]
   },
   {
    "n": 5,
    "lines": [
     {
      "en": "pāṇḍyēśavaṃśatilakaṃ kēralē kēlivigraham ।",
      "kn": "ಪಾಂಡ್ಯೇಶವಂಶತಿಲಕಂ ಕೇರಲೇ ಕೇಲಿವಿಗ್ರಹಮ್ ।",
      "te": "పాండ్యేశవంశతిలకం కేరలే కేలివిగ్రహమ్ ।"
     },
     {
      "en": "ārtatrāṇaparaṃ dēvaṃ śāstāraṃ praṇamāmyaham ॥ 5 ॥",
      "kn": "ಆರ್ತತ್ರಾಣಪರಂ ದೇವಂ ಶಾಸ್ತಾರಂ ಪ್ರಣಮಾಮ್ಯಹಮ್ ॥ 5 ॥",
      "te": "ఆర్తత్రాణపరం దేవం శాస్తారం ప్రణమామ్యహమ్ ॥ 5 ॥"
     }
    ]
   },
   {
    "n": null,
    "lines": [
     {
      "en": "pañcharatnākhyamētadyō nityaṃ śuddhaḥ paṭhēnnaraḥ ।",
      "kn": "ಪಂಚರತ್ನಾಖ್ಯಮೇತದ್ಯೋ ನಿತ್ಯಂ ಶುದ್ಧಃ ಪಠೇನ್ನರಃ ।",
      "te": "పంచరత్నాఖ్యమేతద్యో నిత్యం శుద్ధః పఠేన్నరః ।"
     },
     {
      "en": "tasya prasannō bhagavān śāstā vasati mānasē ॥",
      "kn": "ತಸ್ಯ ಪ್ರಸನ್ನೋ ಭಗವಾನ್ ಶಾಸ್ತಾ ವಸತಿ ಮಾನಸೇ ॥",
      "te": "తస్య ప్రసన్నో భగవాన్ శాస్తా వసతి మానసే ॥"
     }
    ]
   },
   {
    "n": null,
    "lines": [
     {
      "en": "iti śrī śāstā pañcharatnam ।",
      "kn": "ಇತಿ ಶ್ರೀ ಶಾಸ್ತಾ ಪಂಚರತ್ನಮ್ ।",
      "te": "ఇతి శ్రీ శాస్తా పంచరత్నమ్ ।"
     }
    ]
   }
